# ---------------------------------------------------------------------------
# PropIQ environment
# Copy to .env.local for development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Data adapter: "fixture" (labelled demo data) or "supabase" (real records).
# NODE_ENV=production refuses "fixture" outright — see src/lib/env.ts.
PROPIQ_DATA_ADAPTER=fixture

# This deployment's public origin. Baked into canonical links, the sitemap,
# llms.txt, structured data and the auth email redirect, so a production server
# refuses to start while it is unset or points at loopback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required when PROPIQ_DATA_ADAPTER=supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS. Never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (Copilot / Document AI) ---
# Model IDs are configuration, never hard-coded into domain logic.
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=
# AI_FALLBACK_MODEL=
AI_RATE_LIMIT_PER_MINUTE=10

# --- Scheduled jobs ---
# Shared secret for POST /api/cron/evaluate-alerts. Unset = endpoint refuses.
# Minimum 16 characters.
# CRON_SECRET=

# --- Maps ---
NEXT_PUBLIC_MAPS_PROVIDER=none
# NEXT_PUBLIC_MAPS_TOKEN=

# --- Analytics ---
NEXT_PUBLIC_ANALYTICS_DEBUG=0
