#!/usr/bin/env bash
# Bash shim — Claude Code hooks run `command` strings via /bin/sh, so this
# wrapper makes the TypeScript hook executable via bun. Settings.json
# references this file directly.
#
# FAIL-OPEN (F5): a Stop-event telemetry repair must never block the session.
# Every failure path — bun missing, script crash — still exits 0.
GSTACK_BUN_CONFIG=/dev/null; case "${OSTYPE:-}" in msys*|cygwin*) if command -v cygpath >/dev/null 2>&1; then GSTACK_BUN_CONFIG=NUL; fi ;; esac
HERE="$(cd "$(dirname "$0")" && pwd)" || exit 0
TS="$HERE/timeline-stop-hook.ts"
# Windows: bun.exe is a native binary and cannot resolve MSYS paths (/c/...).
command -v cygpath >/dev/null 2>&1 && TS="$(cygpath -w "$TS")"
bun --no-env-file --config="${GSTACK_BUN_CONFIG:-/dev/null}" "$TS" || true
exit 0
