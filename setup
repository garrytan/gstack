  _link_runtime_dists "$gstack_dir" "$factory_gstack"
  if [ -f "$factory_dir/gstack-upgrade/SKILL.md" ]; then
    _copy_skill_md "$factory_dir/gstack-upgrade/SKILL.md" "$factory_gstack/gstack-upgrade/SKILL.md"
