# ─── Remove per-project state ───────────────────────────────
# --keep-state keeps both folders. Otherwise a folder holding git-tracked files
# loses only what git ignores; dirty worktrees were refused above unless
# --force-worktrees was given.
_remove_project_dir() {
  local _dir="$_GIT_ROOT/$1" _tracked
  [ -d "$_dir" ] || return 0
  if ! _tracked="$(git -C "$_GIT_ROOT" ls-files -- "$1" 2>/dev/null)"; then
    echo "kept $_dir/: git could not list its tracked files" >&2
    return 0
  fi
  if [ -z "$_tracked" ]; then
    if [ -n "$(find "$_dir" -name .git -print -quit 2>/dev/null)" ]; then
      echo "kept $_dir/: it holds its own git repository, whose commits may exist nowhere else; check it, then remove it by hand" >&2
      return 0
    fi
    rm -rf "$_dir"
    REMOVED+=("$_dir/")
    return 0
  fi
  git -C "$_GIT_ROOT" clean -fdXq -- "$1" >/dev/null 2>&1 || true
  REMOVED+=("$_dir/ (git-ignored files)")
  echo "kept git-tracked files in $_dir/ (and any untracked file git does not ignore)" >&2
}
if [ -n "$_GIT_ROOT" ] && [ "$KEEP_STATE" -eq 0 ]; then
  _remove_project_dir .gstack
  if [ -L "$_GIT_ROOT/.gstack-worktrees" ] && [ -d "$_GIT_ROOT/.gstack-worktrees" ]; then
    rm -f -- "$_GIT_ROOT/.gstack-worktrees"
    REMOVED+=("$_GIT_ROOT/.gstack-worktrees (link only)")
  elif [ -d "$_GIT_ROOT/.gstack-worktrees" ]; then
    _WTS=()
    _WT_REALS=()
    while IFS= read -r -d '' _WT; do
      [ -n "$_WT" ] || continue
      _WTS+=("$_WT")
      _WT_REALS+=("$(_real "$_WT")")
    done < <(_project_worktrees)
    for _WT in ${_WTS[@]+"${_WTS[@]}"}; do
      rm -rf "$_WT"
    done
    for _WT_REAL in ${_WT_REALS[@]+"${_WT_REALS[@]}"}; do
      [ -n "$_WT_REAL" ] && [ ! -e "$_WT_REAL" ] && git -C "$_GIT_ROOT" worktree remove --force "$_WT_REAL" >/dev/null 2>&1 || true
    done
    _remove_project_dir .gstack-worktrees
  fi
fi

# ─── Remove global state ────────────────────────────────────
if [ "$KEEP_STATE" -eq 0 ] && [ -d "$STATE_DIR" ]; then
  rm -rf "$STATE_DIR"
  REMOVED+=("$STATE_DIR")
fi

# ─── Clean up temp files ────────────────────────────────────
