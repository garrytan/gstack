#!/usr/bin/env -S bun --no-env-file --config=/dev/null
/**
 * gstack-harness — register gstack's skills with the agent harness it is
 * installed into (OpenClaw, Hermes, dots, any other; QM once its pack cap allows), the harness's own
 * way, and take them back out. lib/harness-register.ts holds the targets and
 * the ledger; docs/hosts.md has the per-harness install, verify and uninstall
 * blocks.
 *
 * Usage:
 *   gstack-harness detect [--json]
 *   gstack-harness register <target> [--skills router|hybrid|all] [--skills-dir <dir>] [--context <file>] [--start-hook|--no-start-hook] [--print] [--yes] [--no-registry]
 *     --context <file> writes gstack's marked routing block into that file only
 *     (opt-in: setup, upgrades and refresh never add one, and a block you
 *     delete stays deleted); it prints the file and its scope before writing
 *     --start-hook (OpenClaw, Hermes; opt-in) adds the gstack-start plugin, which
 *     puts a one-line note on every user turn to run a gstack skill's start
 *     command, and turns it on through the harness's own commands (this edits
 *     openclaw.json or Hermes's config.yaml); --no-start-hook takes it out. The
 *     choice is saved; GSTACK_HARNESS_START_HOOK=1|0 or gstack-config
 *     harness_start_hook on|off make it too. Exit 4: skills registered, hook not active
 *   gstack-harness unregister <target|registration id> [--remote]
 *   gstack-harness status [--json] [--no-check]
 *   gstack-harness refresh
 *   gstack-harness auto
 *   gstack-harness manifest <target> [--skills-dir <dir>]
 */
import * as fs from 'node:fs';
import * as os from 'node:os';
import * as path from 'node:path';
import { resolveStateRoot } from '../lib/state-root';
import {
  HarnessError, TARGETS, contextScope, detect, getTarget, harnessSees, listLedgers, printPayload, refresh, register, sourceSkills, status, unregister,
  type RegisterResult, type SkillsMode, type TargetName,
} from '../lib/harness-register';
import { registerQm, removeQmPack } from '../lib/harness-qm';

const argv = process.argv.slice(2);
const flag = (name: string) => { const i = argv.indexOf(name); if (i < 0) return undefined; const v = argv[i + 1]; argv.splice(i, 2); return v; };
const bool = (name: string) => { const i = argv.indexOf(name); if (i < 0) return false; argv.splice(i, 1); return true; };

const checkout = path.resolve(fs.realpathSync(process.argv[1]), '..', '..');
const version = (() => { try { return fs.readFileSync(path.join(checkout, 'VERSION'), 'utf8').trim(); } catch { return 'unknown'; } })();
const stateRoot = resolveStateRoot(process.env);
const env = process.env;
const home = os.homedir();
const self = path.join(checkout, 'bin', 'gstack-harness');

function receiptLines(r: RegisterResult): string[] {
  const t = TARGETS[r.target];
  const how = { router: 'reachable through one router skill', hybrid: 'registered, the task skills listed directly and the rest through one router skill', all: 'registered' }[r.mode];
  return [
    'gstack-harness: ' + t.displayName + ': ' + r.skills + ' gstack skills ' + how + ' at ' + r.dest + ' (' + r.status + (r.written ? ', ' + r.written + ' files written' : '') + ')',
    ...(r.router ? ['  router: ' + r.router + ' (register with --skills all to list every skill natively)'] : []),
    ...r.kept.map(k => '  kept your edit: ' + k),
    ...(r.hook ? ['  start hook: ' + r.hook.state + (r.hook.state === 'active' ? ' (new sessions get the note; a running gateway picks it up when it reloads)' : '') + (r.hook.detail ? ' - ' + r.hook.detail : '') + (r.hook.fix ? '; ' + r.hook.fix : '')] : []),
    '  ledger: ' + r.ledger,
    '  remove: ' + self + ' unregister ' + r.id,
  ];
}
const receipt = (r: RegisterResult) => console.log(receiptLines(r).join('\n'));
/** A start hook this run turned on, or was asked for, that did not end up active: exit 4 after the receipt. */
function hookFailed(r: RegisterResult): number {
  if (!r.hook?.required || r.hook.state === 'active') return 0;
  console.error(new HarnessError('HARNESS_HOOK_INACTIVE', TARGETS[r.target].displayName + ' start hook is ' + r.hook.state + (r.hook.detail ? ': ' + r.hook.detail : '') + (r.hook.fix ? '. Turn it on: ' + r.hook.fix : '')).report());
  return 4;
}

function usage(code: number): never {
  const text = fs.readFileSync(process.argv[1], 'utf8').split('\n').slice(1).filter(l => l.startsWith(' *')).map(l => l.slice(3)).join('\n');
  (code ? console.error : console.log)(text);
  process.exit(code);
}

async function main(): Promise<number> {
  const json = bool('--json');
  const sub = argv.shift();
  const base = { checkout, stateRoot, env, home, version };
  switch (sub) {
    case 'detect': {
      const d = detect(env, home);
      if (json) console.log(JSON.stringify(d));
      else console.log('inside: ' + (d.inside.join(', ') || 'none') + '\npresent: ' + (d.present.join(', ') || 'none'));
      return 0;
    }
    case 'register': {
      const mode = flag('--skills') as SkillsMode | undefined;
      const skillsDir = flag('--skills-dir'); const context = flag('--context');
      const print = bool('--print'); const yes = bool('--yes'); const noRegistry = bool('--no-registry');
      const startHook = bool('--start-hook') ? true : bool('--no-start-hook') ? false : undefined;
      const t = getTarget(argv.shift() ?? '');
      if (print) { console.log(printPayload(checkout)); return 0; }
      if (t.name === 'qm') {
        const r = await registerQm({ ...base, yes });
        console.log('gstack-harness: QM: pack ' + r.packId + ' at ' + r.ref + ' (' + r.status + '); imported: ' + JSON.stringify(r.imported).slice(0, 300));
        console.log('  detach locally: ' + self + ' unregister ' + r.id + '   archive the org pack: ' + self + ' unregister ' + r.id + ' --remote');
        return 0;
      }
      if (t.mechanism === 'verify-only') {
        const seen = harnessSees(t, '', env, ['review', 'gstack-review'], true);
        if (seen.visible === 'yes') { console.log('gstack-harness: ' + t.displayName + ': discovered gstack skills through ~/.claude/skills (Claude-rendered, unverified in a live session); checked: ' + seen.checked); return 0; }
        console.log('gstack-harness: ' + t.displayName + ': unverified (' + (seen.checked ? seen.checked + ' did not list gstack' : t.name + ' is not on PATH') + '). Install gstack for Claude Code (./setup), or paste the block from: ' + self + ' register generic --print');
        return 3;
      }
      if (context) (json ? console.error : console.log)('gstack-harness: context block: ' + path.resolve(context) + ' (' + contextScope(t, context, env, home) + ' scope)');
      const r = register({ ...base, target: t, mode, skillsDir, context, registry: !noRegistry, startHook });
      if (json) console.log(JSON.stringify({ ...r, receipt: receiptLines(r).map(l => l.trim()).join('; ') }));
      else receipt(r);
      return hookFailed(r);
    }
    case 'unregister': {
      const remote = bool('--remote');
      const name = argv.shift() ?? '';
      const matches = listLedgers(stateRoot).filter(l => l.ledger.meta.id === name || l.ledger.meta.target === name);
      if (!matches.length) throw new HarnessError('HARNESS_NOT_REGISTERED', 'no registration named ' + JSON.stringify(name));
      for (const l of matches) {
        if (remote && l.ledger.meta.target === 'qm') {
          console.log('gstack-harness: archived QM pack ' + await removeQmPack(stateRoot, env, l.ledger.meta.id));
          fs.rmSync(l.file);
          console.log('gstack-harness: removed ' + l.ledger.meta.id);
        } else for (const id of unregister(stateRoot, checkout, l.ledger.meta.id, env)) console.log('gstack-harness: removed ' + id);
      }
      return 0;
    }
    case 'status': {
      const check = !bool('--no-check');
      const rows = status(stateRoot, version, env, check);
      const extra = (['muse', 'grok'] as TargetName[]).filter(n => TARGETS[n].present(env, home)).map(n => ({ target: n, ...(check ? harnessSees(TARGETS[n], '', env, ['review', 'gstack-review'], true) : { visible: 'unknown' as const }) }));
      if (json) { console.log(JSON.stringify({ registrations: rows, detected: extra })); return 0; }
      if (!rows.length && !extra.length) console.log('gstack-harness: no harness registrations on this machine');
      for (const r of rows) console.log(r.target + '\t' + r.mode + '\t' + r.dest + '\t' + r.files + ' files\t' + (r.stale ? 'stale (' + r.version + '; refresh: ' + self + ' refresh)' : r.version) + '\tvisible to harness: ' + r.visible + (r.checked ? ' (' + r.checked + ')' : '') + (r.missing?.length ? ' missing: ' + r.missing.slice(0, 5).join(', ') : '') + '\t' + r.id
        + (r.hook ? '\n  start hook: ' + r.hook.state + (r.hook.detail ? ' - ' + r.hook.detail : '') + (r.hook.state !== 'active' && r.hook.fix ? '; ' + r.hook.fix : '') : ''));
      for (const x of extra) console.log(x.target + '\tdetect\t~/.claude/skills\t' + (x.visible === 'yes' ? 'discovered (Claude-rendered, unverified)' : 'unverified') + (x.checked ? ' (' + x.checked + ')' : ''));
      return 0;
    }
    case 'refresh': {
      let code = 0;
      for (const r of refresh(base)) { if (r.status !== 'unchanged' || r.hook?.required || r.hook?.retried || r.hook?.detail) receipt(r); code ||= hookFailed(r); }
      return code;
    }
    case 'auto': {
      const d = detect(env, home);
      let failed = 0;
      const done = new Set<string>();
      for (const n of d.inside.filter(n => TARGETS[n].mechanism === 'skill-folder')) {
        try { const r = register({ ...base, target: TARGETS[n], registry: true }); done.add(r.id); receipt(r); hookFailed(r); }
        catch (e) { if (e instanceof HarnessError) { console.error(e.report()); failed = 1; } else throw e; }
      }
      try { for (const r of refresh(base, done)) { if (r.status !== 'unchanged' || r.hook?.required || r.hook?.retried || r.hook?.detail) receipt(r); hookFailed(r); } }
      catch (e) { if (e instanceof HarnessError) { console.error(e.report()); failed = 1; } else throw e; }
      for (const n of d.present.filter(n => !d.inside.includes(n) && TARGETS[n].mechanism === 'skill-folder' && !listLedgers(stateRoot).some(l => l.ledger.meta.target === n))) {
        console.log('gstack-harness: ' + TARGETS[n].displayName + ' is installed here; to give it gstack skills: ' + self + ' register ' + n);
      }
      return failed;
    }
    case 'manifest': {
      const t = getTarget(argv.shift() ?? 'generic');
      const skills = sourceSkills(t.render ? t : TARGETS.generic, checkout, fs.mkdtempSync(path.join(os.tmpdir(), 'gstack-harness-')));
      console.log(JSON.stringify({ schema: 1, gstack_version: version, target: t.name, skills: skills.map(s => ({ name: s.name, use: s.use, path: path.join(s.dir, 'SKILL.md') })) }, null, 2));
      return 0;
    }
    case '--help': case '-h': case 'help': return usage(0);
    default: return usage(2);
  }
}

main().then(code => process.exit(code), (e) => {
  if (e instanceof HarnessError) { console.error(e.report()); process.exit(1); }
  throw e;
});
