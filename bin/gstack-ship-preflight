#!/usr/bin/env -S bun --no-env-file --config=/dev/null
/**
 * gstack-ship-preflight — /ship Steps 1-3 and Step 5's pregate and lanes in one call, with
 * STOP:/NEXT: lines wherever the agent must judge. Logic: lib/ship-preflight.ts.
 */
import { preflight } from '../lib/ship-preflight';

const out = await preflight(process.argv.slice(2), process.cwd());
(out.exit === 2 ? process.stderr : process.stdout).write(out.text);
process.exit(out.exit);
