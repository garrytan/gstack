#!/usr/bin/env -S bun --no-env-file --config=/dev/null
/**
 * gstack-founder-resources — the office-hours founder-resource pool, served on demand.
 *
 *   gstack-founder-resources index [--shown <url,url,...>]
 *   gstack-founder-resources show <id> [<id>...]
 *
 * `index` prints RESOURCES_TOTAL, RESOURCES_SHOWN_COUNT, then either
 * `RESOURCES: exhausted` or one line per entry the user has not been shown:
 * `<id>. [<category>] "<title>" (<length>)`. Shown URLs come from the builder
 * profile (`gstack-developer-profile --read`, RESOURCES_SHOWN) unless
 * --shown is given. `show` prints the chosen entries in full under their
 * category headers. Exit 0, or 2 on a usage error or an unknown id.
 * Data: lib/founder-resources.ts.
 */
import * as path from 'node:path';
import { renderChosen, renderIndex } from '../lib/founder-resources';
import { runScriptSync } from '../lib/script-invocation';

const USAGE = 'usage: gstack-founder-resources index [--shown <url,...>] | show <id> [<id>...]';

function shownFromProfile(): string[] {
  const r = runScriptSync(path.join(import.meta.dir, 'gstack-developer-profile'), ['--read'], { encoding: 'utf8', timeout: 15_000 });
  const line = (r.stdout ?? '').split('\n').find(l => l.startsWith('RESOURCES_SHOWN: '));
  return line ? line.slice('RESOURCES_SHOWN: '.length).split(',').map(s => s.trim()).filter(Boolean) : [];
}

const [cmd, ...rest] = process.argv.slice(2);
if (cmd === 'index') {
  const at = rest.indexOf('--shown');
  const shown = at >= 0 ? (rest[at + 1] ?? '').split(',').map(s => s.trim()).filter(Boolean) : shownFromProfile();
  process.stdout.write(renderIndex(shown));
} else if (cmd === 'show' && rest.length) {
  const ids = rest.map(Number);
  const { text, unknown } = renderChosen(ids.filter(Number.isInteger));
  process.stdout.write(text);
  const bad = [...unknown, ...rest.filter(a => !Number.isInteger(Number(a)))];
  if (bad.length) {
    process.stderr.write(`RESOURCES_UNKNOWN: ${bad.join(' ')}\n`);
    process.exit(2);
  }
} else {
  process.stderr.write(`${USAGE}\n`);
  process.exit(cmd === '--help' || cmd === '-h' ? 0 : 2);
}
