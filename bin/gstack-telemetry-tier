#!/usr/bin/env bash
# gstack-telemetry-tier — the tier this session's telemetry goes out at.
#
#   gstack-telemetry-tier          → off | anonymous | community
#   gstack-telemetry-tier --capy   → the Capy opt-in alone: anonymous | off
#
# A Capy session (GSTACK_CAPY=1) is opted in only by the owner's preferences
# file (GSTACK_PREFERENCES_FILE, beside the Capy skill's SKILL.md) holding
# exactly one `telemetry_capy: anonymous` line. It then sends at the anonymous
# tier whatever this machine's `telemetry` setting says, and
# gstack-telemetry-log labels it source=capy. Only anonymous: community's
# installation_id is a stable device id, and Capy's consent rules one out
# (docs/privacy.md). No file, no line, two lines, another value or a file over
# 4 KB is off. Without the opt-in this prints the machine's own setting.
# Unattended sessions stay silent unless opted in: gstack-skill-end asks --capy.

capy=off
f="${GSTACK_PREFERENCES_FILE:-}"
if [ "${GSTACK_CAPY:-}" = "1" ] && [ -n "$f" ] && [ -f "$f" ] && [ "$(wc -c < "$f" 2>/dev/null || echo 4097)" -le 4096 ]; then
  bom=$(printf '\357\273\277')
  lines=$(LC_ALL=C sed -e "1s/^$bom//" "$f" 2>/dev/null | tr -d '\r' | grep -E '^telemetry_capy:' || true)
  if [ -n "$lines" ] && [ "$(printf '%s\n' "$lines" | wc -l | tr -d ' ')" = 1 ]; then
    v=$(printf '%s' "${lines#telemetry_capy:}" | sed -e 's/[[:space:]]#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e "s/^\([\"']\)\(.*\)\1\$/\2/")
    [ "$v" = anonymous ] && capy=anonymous
  fi
fi
if [ "${1:-}" = "--capy" ] || [ "$capy" != off ]; then
  echo "$capy"
  exit 0
fi
tier=$("$(dirname "$0")/gstack-config" get telemetry 2>/dev/null || true)
case "$tier" in
  anonymous|community) echo "$tier" ;;
  *) echo off ;;
esac
