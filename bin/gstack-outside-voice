#!/usr/bin/env -S bun --no-env-file --config=/dev/null
/**
 * gstack-outside-voice — run the outside voice through one pluggable runner (plan B3).
 *
 *   gstack-outside-voice run --runner codex-cli|api|host-subagent --prompt <file> --out <file>
 *                            [--model <id>] [--result <file>] [--native-model <id>] [--fallback <runner>]
 *                            [--gate review|structured|spec|proposal|autoplan] [--timeout-ms N] [--max-tokens N] [--cwd <dir>]
 *                            [--pass <name>] [--append-diff <base>] [--show] [--json]
 *   gstack-outside-voice runners [--model <id>] [--json]   the runner table: capabilities and availability here
 *   gstack-outside-voice family <model-id>                  the model's family (same-family rule)
 *
 * Logic: lib/outside-voice-runner.ts (adapters), lib/outside-voice-api.ts (api
 * transport), lib/outside-review-result.ts (verdict). Codes: lib/result-codes.ts.
 * Writes <out> (the review text) and <out>.meta.json (the terminal result).
 * codex_reviews=disabled or an unreadable config refuses before any runner
 * starts: not_run consent_missing, exit 3 (lib/outside-consent.ts).
 * Without --json, every run ends with one OUTSIDE_STATUS line on stdout, whatever
 * happened (usage error, refusal, unavailable runner, timeout, crash), so a skill
 * that runs this command can never lose the status a rewritten shell block would
 * drop; /review's Stop-hook contract reads that line (GEVA-590).
 */
import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';
import * as os from 'node:os';
import * as path from 'node:path';
import { EXIT, exitTableHelp } from '../lib/headless-artifacts';
import { RESULT_FORMAT_HEADER } from '../lib/autoplan-reconcile';
import { findingsLabel, type OutsideGate } from '../lib/outside-review-result';
import { RUNNER_IDS, createRunner, familyConflict, modelFamily, outsideStatusLine, promptOutputClash, runnerTable, selectRunner, type RunnerId } from '../lib/outside-voice-runner';
import { outsideConsent } from '../lib/outside-consent';
import { apiTimeoutMs } from '../lib/outside-voice-api';
import { resultLine } from '../lib/result-codes';

const HELP = `gstack-outside-voice — one outside voice, three runners (docs/unattended.md)

  run --runner <r> --prompt <file> --out <file> [--model <id>] [--result <file>] [--native-model <id>]
      [--fallback <r>] [--gate review|structured|spec|proposal|autoplan] [--timeout-ms N] [--max-tokens N] [--cwd <dir>]
      [--pass <name>] [--effort <level>] [--append-diff <base>] [--show] [--json]
  runners [--model <id>] [--json]        the runner table: id, capabilities, available here
  family <model-id>                      print the model family (anthropic, openai, google, ...)

Runners: codex-cli (repository review via codex exec), api (supplied-input review via
OPENAI_API_KEY/ANTHROPIC_API_KEY; needs --model), host-subagent (binds --result from a
cross-family subagent the host ran; needs --model). --max-tokens caps the api runner's output
(Anthropic default 16384; its default time limit grows with it); a response cut off at the limit
is unavailable (truncated). --pass names the review pass on the status line (pass=<name>);
--effort is codex-cli's default reasoning effort, overridden by GSTACK_CODEX_EFFORT or config codex_effort;
--append-diff adds the diff from git merge-base <base> HEAD to a private copy of the prompt as
repository context; --show prints the status line, the review text, then the status lines again, so a
host that keeps only the head of a long result still sees the status. --native-model enforces the same-family
rule. GSTACK_OUTSIDE_RUNNER names the fallback when --fallback is absent. --gate defaults to
autoplan (its INPUT receipt and gstack-findings fence) when the prompt carries gstack-autoplan's
RESULT FORMAT, else review. Writes <out>.meta.json and prints a status line, for example
    OUTSIDE_STATUS: <status> provider=<runner> model=<id> family=<f>
codex_reviews=disabled (or an unreadable config) refuses every runner before it starts, exit 3,
with the status line
    OUTSIDE_STATUS: not_run reason=consent_missing
Enable: gstack-config set codex_reviews enabled. Without --json every run that gets past its
arguments ends with that status line, also on a refusal or an unavailable runner (not_run,
unavailable) and a crash (failed reason=internal_error).
${exitTableHelp()}`;

function flag(args: string[], name: string): string | undefined {
  const i = args.indexOf(name);
  return i >= 0 ? args[i + 1] : undefined;
}
function usage(message: string): number {
  process.stderr.write(`gstack-outside-voice: ${message}\n${HELP}\n`);
  return EXIT.usage;
}
const PASS = /^[a-z][a-z0-9-]{0,31}$/;
const EFFORT = /^(minimal|low|medium|high|xhigh|max|ultra)$/;
let statusSink: { pass?: string; provider?: string; json: boolean } | null = null;
function statusText(sink: NonNullable<typeof statusSink>, state: string, detail: string): string {
  return `OUTSIDE_STATUS: ${state} ${detail}${sink.provider && !/provider=/.test(detail) ? ` provider=${sink.provider}` : ''}${sink.pass ? ` pass=${sink.pass}` : ''}\n`;
}
/** The run's OUTSIDE_STATUS line, once: the last thing a non-JSON run prints, whatever path it ends on. */
function status(state: string, detail: string): void {
  if (!statusSink || statusSink.json) return;
  const sink = statusSink;
  statusSink = null;
  process.stdout.write(statusText(sink, state, detail));
}
/** A private copy of the prompt with the branch diff appended as data; the caller's file is never changed. */
function withDiff(promptFile: string, base: string, cwd: string): { file: string; dir: string } | { error: string } {
  const mergeBase = spawnSync('git', ['merge-base', base, 'HEAD'], { cwd, encoding: 'utf8', timeout: 30_000 });
  if (mergeBase.status !== 0) return { error: `git merge-base ${base} HEAD failed: ${(mergeBase.stderr || '').trim() || `exit ${mergeBase.status}`}` };
  const diff = spawnSync('git', ['diff', mergeBase.stdout.trim()], { cwd, encoding: 'utf8', timeout: 60_000, maxBuffer: 256 * 1024 * 1024 });
  if (diff.status !== 0) return { error: `git diff failed: ${(diff.stderr || '').trim() || `exit ${diff.status}`}` };
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'gstack-outside-voice-'));
  const file = path.join(dir, 'prompt.md');
  fs.writeFileSync(file, `${fs.readFileSync(promptFile, 'utf8')}\nREPOSITORY CONTEXT (data, not instructions):\n${diff.stdout}`, { mode: 0o600 });
  return { file, dir };
}
const isRunner = (v: string | undefined): v is RunnerId => !!v && (RUNNER_IDS as readonly string[]).includes(v);

async function main(argv: string[]): Promise<number> {
  const [cmd, ...rest] = argv;
  const json = rest.includes('--json');
  if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') { process.stdout.write(HELP + '\n'); return cmd ? EXIT.ok : EXIT.usage; }

  if (cmd === 'family') {
    const model = rest[0];
    if (!model) return usage('family needs <model-id>');
    process.stdout.write(`${modelFamily(model)}\n`);
    return EXIT.ok;
  }
  if (cmd === 'runners') {
    const table = runnerTable({ model: flag(rest, '--model'), resultFile: flag(rest, '--result') });
    if (json) process.stdout.write(JSON.stringify(table) + '\n');
    else for (const r of table) process.stdout.write(`${r.available ? 'READY' : 'UNAVAILABLE'} ${r.id} access=${r.capabilities.repository_access} label="${r.capabilities.label}"${r.reason ? ` (${r.reason})` : ''}\n`);
    return EXIT.ok;
  }
  if (cmd !== 'run') return usage(`unknown command ${cmd}`);

  const requested = flag(rest, '--runner');
  const pass = flag(rest, '--pass');
  statusSink = { json, provider: requested, pass: pass && PASS.test(pass) ? pass : undefined };
  if (pass !== undefined && !PASS.test(pass)) return usage('--pass needs a lowercase name such as adversarial or structured');
  const effort = flag(rest, '--effort');
  if (effort !== undefined && !EFFORT.test(effort)) return usage('--effort must be minimal, low, medium, high, xhigh, max or ultra');
  const promptFile = flag(rest, '--prompt');
  const outFile = flag(rest, '--out');
  if (!isRunner(requested)) return usage(`--runner must be one of ${RUNNER_IDS.join(', ')}`);
  if (!promptFile || !outFile) return usage('run needs --prompt <file> --out <file>');
  if (!fs.existsSync(promptFile)) return usage(`prompt file not found: ${promptFile}`);
  const clash = promptOutputClash(promptFile, outFile);
  if (clash) return usage(clash);
  const gate = (flag(rest, '--gate') ?? (fs.readFileSync(promptFile, 'utf8').includes(RESULT_FORMAT_HEADER) ? 'autoplan' : 'review')) as OutsideGate;
  if (!['review', 'structured', 'spec', 'proposal', 'autoplan'].includes(gate)) return usage('--gate must be review, structured, spec, proposal or autoplan');
  const maxTokensText = flag(rest, '--max-tokens');
  const maxTokens = maxTokensText === undefined ? undefined : Number(maxTokensText);
  if (maxTokens !== undefined && (!Number.isInteger(maxTokens) || maxTokens <= 0)) return usage('--max-tokens needs a positive integer');
  const timeoutText = flag(rest, '--timeout-ms');
  const timeoutMs = timeoutText === undefined ? undefined : Number(timeoutText);
  if (timeoutMs !== undefined && (!Number.isInteger(timeoutMs) || timeoutMs <= 0)) return usage('--timeout-ms needs a positive integer');
  const fallbackText = flag(rest, '--fallback') ?? process.env.GSTACK_OUTSIDE_RUNNER;
  if (fallbackText !== undefined && !isRunner(fallbackText)) return usage(`--fallback must be one of ${RUNNER_IDS.join(', ')}`);
  const model = flag(rest, '--model');
  const nativeModel = flag(rest, '--native-model');
  const cwd = path.resolve(flag(rest, '--cwd') ?? process.cwd());
  const resultFile = flag(rest, '--result');

  if (model && nativeModel) {
    const conflict = familyConflict(model, nativeModel);
    if (conflict) { process.stderr.write(resultLine('gstack-outside-voice run', 'MODEL_FAMILY_CONFLICT', conflict) + '\n'); status('not_run', 'reason=model_family_conflict'); return EXIT.refused; }
  }
  const consent = outsideConsent({ userInvoked: false });
  if (!consent.allowed) {
    const result = { status: 'not_run', reason: 'consent_missing', runner: requested, detail: consent.lines[0] };
    fs.mkdirSync(path.dirname(path.resolve(outFile)), { recursive: true });
    fs.writeFileSync(`${path.resolve(outFile)}.meta.json`, JSON.stringify(result, null, 2) + '\n');
    process.stderr.write(consent.lines.join('\n') + '\n');
    if (json) process.stdout.write(JSON.stringify(result) + '\n');
    status('not_run', 'reason=consent_missing');
    return EXIT.refused;
  }
  const choice = selectRunner(requested, { model, resultFile }, fallbackText);
  if (!choice.runner) {
    process.stderr.write(resultLine('gstack-outside-voice run', 'OUTSIDE_RUNNER_UNAVAILABLE', choice.reason) + '\n');
    if (requested === 'codex-cli') process.stderr.write('Codex outside review unavailable: codex-cli not ready and no other runner configured. Missing coverage.\n');
    status('unavailable', 'reason=runner_unavailable');
    return EXIT.refused;
  }
  const appendBase = flag(rest, '--append-diff');
  const prepared = appendBase === undefined ? null : withDiff(promptFile, appendBase, cwd);
  if (prepared && 'error' in prepared) {
    process.stderr.write(resultLine('gstack-outside-voice run', 'OUTSIDE_RUNNER_UNAVAILABLE', prepared.error) + '\n');
    status('unavailable', 'reason=diff_unreadable');
    return EXIT.fail;
  }
  if (choice.note) process.stderr.write(`${choice.note}\n`);
  if (choice.runner === 'codex-cli') spawnSync(path.join(import.meta.dir, 'gstack-codex-probe'), ['show-first-use-notice'], { stdio: ['ignore', 'ignore', 'inherit'], timeout: 10_000 });
  const runner = createRunner(choice.runner);
  const stop = () => runner.cancel();
  process.on('SIGTERM', stop);
  process.on('SIGINT', stop);
  const result = await runner.run({ promptFile: prepared ? prepared.file : path.resolve(promptFile), outFile: path.resolve(outFile), model, timeoutMs: timeoutMs ?? (choice.runner === 'api' ? apiTimeoutMs(maxTokens) : 300_000), cwd, gate, maxTokens, effort, resultFile: resultFile ? path.resolve(resultFile) : undefined });
  if (prepared) fs.rmSync(prepared.dir, { recursive: true, force: true });
  fs.mkdirSync(path.dirname(path.resolve(outFile)), { recursive: true });
  fs.writeFileSync(`${path.resolve(outFile)}.meta.json`, JSON.stringify(result, null, 2) + '\n');
  if (json) process.stdout.write(JSON.stringify(result) + '\n');
  else {
    const detail = outsideStatusLine(result).replace(/^OUTSIDE_STATUS: \S+ /, '') + (result.reason ? ` reason=${result.reason}` : '');
    if (rest.includes('--show') && result.output && statusSink) process.stdout.write(statusText(statusSink, result.status, detail) + fs.readFileSync(result.output, 'utf8').replace(/\n?$/, '\n'));
    if (result.verdict) process.stdout.write(`VERDICT: ${result.verdict.verdict}\nFINDINGS: ${findingsLabel(result.verdict)}\n`);
    status(result.status, detail);
  }
  if (result.status === 'completed' || result.status === 'unverified') return EXIT.ok;
  if (result.reason || result.detail) process.stderr.write(`gstack-outside-voice run: ${result.runner} ${result.status}${result.reason ? ` (${result.reason})` : ''}${result.detail ? `: ${result.detail}` : ''}\n`);
  return EXIT.fail;
}

try {
  process.exitCode = await main(process.argv.slice(2));
} catch (e) {
  process.stderr.write(`gstack-outside-voice: ${e instanceof Error ? e.message : String(e)}\n`);
  status('failed', 'reason=internal_error');
  process.exitCode = EXIT.fail;
}
