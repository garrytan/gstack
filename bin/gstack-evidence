import { scan, applyRedactions } from "../lib/redact-engine";
import { ledgerCandidates, readJsonlUnion, resolveProjectIdentity, resolveRegisteredProjectLocation, resolveWorkspaceGovernanceLocation } from "../lib/project-identity";
import { buildEvidenceRecord, type EvidenceRecordV2 } from "../lib/evidence-envelope";
import { resolveTrustedActivationSnapshot, resolveTrustedWorkProfile } from "../lib/trusted-base";
import { ensureValidator, evaluateValidatorBinding } from "../lib/validator-runner";
import type { Lane } from "../lib/work-profile";
import { appendShipHandoff, inspectCurrentShipHandoff } from "../lib/ship-handoff";
import { snapshotProviderHead, snapshotSafetyProviderPreflight } from "../lib/provider-access";
import { advancePrivatePilotWorkspace, cleanupPrivatePilotWorkspace, initPrivatePilotWorkspace, inspectPrivatePilotWorkspace } from "../lib/private-pilot-workspace";
