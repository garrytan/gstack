function closeoutArgs(argv: string[]): { values: Map<string, string>; explicitClose: boolean; json: boolean } {
  const allowed = new Set(['--work-kind', '--finish-line', '--assert-target-ref', '--assert-target-sha', '--lane', '--assert-product-head', '--terminal-subject-kind', '--terminal-subject-id', '--assert-report-path']);
  const values = new Map<string, string>(); let explicitClose = false; let json = false;
  while (argv.length) { const flag = argv.shift()!; if (flag === '--json' || flag === '--explicit-close') { if ((flag === '--json' && json) || (flag === '--explicit-close' && explicitClose)) throw new Error('closeout_arguments_invalid'); if (flag === '--json') json = true; else explicitClose = true; continue; } const value = argv.shift(); if (!allowed.has(flag) || !value || value.startsWith('--') || values.has(flag)) throw new Error('closeout_arguments_invalid'); values.set(flag, value); }
  return { values, explicitClose, json };
}
function closeoutStatusCommand(argv: string[]): number {
  const operation = argv.shift(); const parsed = closeoutArgs(argv); const workKind = parsed.values.get('--work-kind'); const finishLine = parsed.values.get('--finish-line') as FinishLine; const lane = (parsed.values.get('--lane') ?? 'single_repo_code') as Lane;
  if (!parsed.json || !['inspect', 'prepare'].includes(operation ?? '') || !workKind || !['answer', 'design', 'diagnose', 'change', 'review', 'release', 'operation'].includes(workKind) || !['response', 'artifact', 'local_change', 'review_receipt', 'pr_open', 'merged', 'deployed', 'verified', 'operation_result'].includes(finishLine) || !['docs_ux', 'single_repo_code', 'cross_repo_contract'].includes(lane) || (parsed.values.has('--assert-target-ref') && parsed.values.has('--assert-target-sha'))) throw new Error('closeout_arguments_invalid');
  if (operation === 'inspect' && parsed.values.has('--assert-report-path')) throw new Error('closeout_arguments_invalid'); if (operation === 'prepare' && !parsed.values.has('--assert-report-path')) throw new Error('closeout_arguments_invalid');
  const common = { cwd: process.cwd(), stateRoot: resolveRuntimeStateRoot().root, workKind, requestedFinishLine: finishLine, lane, assertTargetRef: parsed.values.get('--assert-target-ref'), assertTargetSha: parsed.values.get('--assert-target-sha'), explicitClose: parsed.explicitClose, assertProductHead: parsed.values.get('--assert-product-head'), terminalSubjectKind: parsed.values.get('--terminal-subject-kind') as 'pr' | 'deploy_operation' | 'rollback_record' | undefined, terminalSubjectId: parsed.values.get('--terminal-subject-id') };
  const result = operation === 'prepare' ? prepareCurrentCloseout({ ...common, assertReportPath: parsed.values.get('--assert-report-path')! }) : deriveCurrentCloseoutStatus(common); console.log(JSON.stringify(result)); return result.proof_current ? 0 : 1;
}
