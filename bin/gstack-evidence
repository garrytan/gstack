ter(id=>!validators.has(id)).length,efficiency_regressed:false};const result=recordLanePromotionAssessment({stateRoot,snapshot});console.log(JSON.stringify(result));return result.eligible?0:1}
function laneCanaryCommand(argv:string[]):number{
  const operation=argv.shift();const focusedOperation=operation==='focused-run'?argv.shift():null;
  const{values,json}=exactArgs(argv,['--block-id','--participant','--lane','--focused-run-id']);const blockId=values.get('--block-id'),lane=values.get('--lane')as Lane,focusedRunId=values.get('--focused-run-id');
  if(!json||!blockId||values.get('--participant')!=='portfolioops'||!ECPE_PILOT_LANES.includes(lane)||!['inspect','run','focused-run'].includes(operation??'')||(operation==='focused-run'&&focusedOperation!=='inspect')||(operation==='run'?!focusedRunId:!!focusedRunId))throw new Error('lane_canary_arguments_invalid');
  const stateRoot=resolveRuntimeStateRoot().root;const block=readMilestoneBlock(stateRoot,blockId);if(!block.participants.includes('portfolioops')||!block.lanes.includes(lane))throw new Error('lane_canary_block_invalid');
  const portfolio=resolveRegisteredProjectLocation('portfolioops',process.cwd());const profile=resolveTrustedWorkProfile({cwd:portfolio.root,lane,safetyStateRoot:stateRoot});const profileHash=profile.effective?.semantic_policy_hash;if(!profileHash||profile.lane_activation!=='enforce')throw new Error('lane_canary_lineage_invalid');
  if(operation==='inspect'){console.log(JSON.stringify(inspectCanaryWindow({stateRoot,repoId:portfolio.identity.repo_id,lane,profileHash})));return 0}
  const head=spawnSync('/usr/bin/git',['rev-parse','HEAD^{commit}'],{cwd:portfolio.root,encoding:'utf8',shell:false,env:{PATH:'/usr/bin:/bin',LC_ALL:'C',GIT_CONFIG_NOSYSTEM:'1'}}).stdout.trim();const tree=spawnSync('/usr/bin/git',['rev-parse','HEAD^{tree}'],{cwd:portfolio.root,encoding:'utf8',shell:false,env:{PATH:'/usr/bin:/bin',LC_ALL:'C',GIT_CONFIG_NOSYSTEM:'1'}}).stdout.trim();if(!/^[0-9a-f]{40}$/.test(head)||!/^[0-9a-f]{40}$/.test(tree))throw new Error('lane_canary_subject_invalid');
  const current={stateRoot,repoId:portfolio.identity.repo_id,lane,profileHash,blockId,participant:'portfolioops' as const,subjectHead:head,subjectTree:tree,hostFingerprint:localCanaryHostFingerprint(),policyHash:block.policy_hash};const binding={...current,focusedRunId:focusedRunId??inspectCurrentCanaryFocusedSlot(current).focused_run_id};
  const result=operation==='focused-run'?inspectCanaryFocusedRun(binding):runCanaryControl({...binding,sourceRepository:portfolio.root},{resolveSafetySnapshot:()=>{const snapshot=resolveTrustedActivationSnapshot({cwd:portfolio.root,safetyStateRoot:stateRoot});return{activations:snapshot.activations,profileBlobSha:snapshot.profile_blob_sha}}});console.log(JSON.stringify(result));return 0
}
async function milestoneBlockCommand(argv: string[]): Promise<number> {
  const operation = argv.shift();
  if (operation === 'start') {
    let purpose = ''; let duration = ''; let json = false;
    const participants: string[] = []; const lanes: string[] = [];
    while (argv.length) {
      const flag = argv.shift()!;
      if (flag === '--json') { if (json) throw new Error('milestone_arguments_invalid'); json = true; continue; }
      const value = argv.shift();
      if (!value || value.startsWith('--')) throw new Error('milestone_arguments_invalid');
      if (flag === '--purpose') purpose = value;
      else if (flag === '--duration') duration = value;
      else if (flag === '--participant') participants.push(value);
      else if (flag === '--lane') lanes.push(value);
      else throw new Error('milestone_arguments_invalid');
    }
    if (!json || purpose !== 'ecpe-v3-pilot' || duration !== 'P30D' || JSON.stringify(participants) !== JSON.stringify([...ECPE_PILOT_PARTICIPANTS]) || JSON.stringify(lanes) !== JSON.stringify([...ECPE_PILOT_LANES])) throw new Error('milestone_arguments_invalid');
    const context = milestoneContext();
    const portfolio = resolveRegisteredProjectLocation('portfolioops', process.cwd());
    const preflight = buildSafetySourcePreflightFromProvider(await snapshotSafetyProviderPreflight(portfolio.root));
    if (!preflight.ready) throw new Error('milestone_safety_preflight_not_ready');
    console.log(JSON.stringify(startMilestoneBlock({ stateRoot: context.state.root, roots: context.roots, codeRootHead: context.codeHead, registryHash: context.registryHash, duration: 'P30D', participants, lanes, safetyPreflightId: preflight.preflight_id })));
    return 0;
  }
  if (operation === 'inspect' || operation === 'inspect-for-partial') {
    const { values, json } = exactArgs(argv, ['--purpose']);
    if (!json || values.get('--purpose') !== 'ecpe-v3-pilot') throw new Error('milestone_arguments_invalid');
    const context = milestoneContext();
    const result = operation === 'inspect' ? inspectMilestoneBlock({ stateRoot: context.state.root, roots: context.roots }) : inspectMilestoneForPartial({ stateRoot: context.state.root, roots: context.roots });
    console.log(JSON.stringify(result));
    return 0;
  }
  if (operation === 'stop') {
    const { values, json } = exactArgs(argv, ['--block-id', '--reason']);
    if (!json || values.get('--reason') !== 'abort' || !values.get('--block-id')) throw new Error('milestone_arguments_invalid');
    const context = milestoneContext();
    console.log(JSON.stringify(stopMilestoneBlock({ stateRoot: context.state.root, roots: context.roots, blockId: values.get('--block-id')!, reason: 'aborted' })));
    return 0;
  }
  if (operation === 'checkpoint') {
    const { values, json } = exactArgs(argv, ['--block-id', '--evaluation-slot', '--participant', '--lane', '--validator', '--expected-base', '--expected-head', '--verification-proof-id', '--verification-result-id']);
    const blockId = values.get('--block-id'), slotId = values.get('--evaluation-slot'), expectedBase = values.get('--expected-base'), expectedHead = values.get('--expected-head'), proofId = values.get('--verification-proof-id'), resultId = values.get('--verification-result-id');
    if (!json || !blockId || !slotId || values.get('--participant') !== 'harness-governance' || values.get('--lane') !== 'docs_ux' || values.get('--validator') !== 'harness.t4' || !expectedBase || !expectedHead || (proofId && resultId)) throw new Error('milestone_arguments_invalid');
    const context = milestoneContext();
    const block = findMilestoneBlockBySlot(context.state.root, slotId);
    if (block.block_id !== blockId) throw new Error('milestone_block_assertion_mismatch');
    const result = proofId ? attachHarnessVerificationCheckpoint({ stateRoot: context.state.root, blockId, slotId, governanceRoot: context.governance.code_root, registryHash: context.registryHash, expectedBase, expectedHead, verificationProofId: proofId }) : resultId ? terminalizeHarnessVerificationCheckpoint({ stateRoot: context.state.root, blockId, slotId, governanceRoot: context.governance.code_root, registryHash: context.registryHash, expectedBase, expectedHead, verificationResultId: resultId }) : claimHarnessVerificationProducer({ stateRoot: context.state.root, blockId, slotId, expectedBase, expectedHead });
    console.log(JSON.stringify(result));
    return resultId ? 1 : 0;
  }
  throw new Error('milestone_arguments_invalid');
}
function pilotReadiness(blockId:string){const context=milestoneContext();const block=readMilestoneBlock(context.state.root,blockId);if(JSON.stringify(block.roots)!==JSON.stringify(context.roots))throw new Error('milestone_root_mismatch');let cdoRun='';let cdoHash='';const codeTreeResult=spawnSync('/usr/bin/git',['rev-parse','HEAD^{tree}'],{cwd:context.governance.code_root,encoding:'utf8',env:{PATH:'/usr/bin:/bin',LC_ALL:'C'}});const codeTree=codeTreeResult.status===0?codeTreeResult.stdout.trim():'';const hashes:any={'portfolioops':'','cdo-os':'','harness-governance':codeTree?sha256(`${context.codeHead}\0${codeTree}\0${context.registryHash}`):''};try{const cdo=resolveRegisteredProjectLocation('cdo-os',process.cwd());const inspected=inspectCandidatePreview({stateRoot:context.state.root,blockId,sourceRepository:cdo.root});cdoRun=inspected.run_id;cdoHash=sha256(`${inspected.subject_head_sha}\0${inspected.subject_tree_sha}\0${inspected.run_id}`);hashes['cdo-os']=cdoHash;}catch{}try{const portfolio=resolveRegisteredProjectLocation('portfolioops',process.cwd());const head=spawnSync('/usr/bin/git',['rev-parse','HEAD^{commit}'],{cwd:portfolio.root,encoding:'utf8',env:{PATH:'/usr/bin:/bin',LC_ALL:'C'}});const tree=spawnSync('/usr/bin/git',['rev-parse','HEAD^{tree}'],{cwd:portfolio.root,encoding:'utf8',env:{PATH:'/usr/bin:/bin',LC_ALL:'C'}});if(head.status===0&&tree.status===0)hashes.portfolioops=sha256(`${head.stdout.trim()}\0${tree.stdout.trim()}`);}catch{}const readiness=buildPilotReadiness({blockJournalRevision:block.revision,compiledPolicyHash:block.policy_hash,roster:block.participants as any,sourceRegistryHash:SAFETY_SOURCE_REGISTRY_HASH,sourceCursorHash:sha256(`${SAFETY_SOURCE_REGISTRY_HASH}\0${context.registryHash}\0${cdoRun}\0${hashes.portfolioops}`),participantSubjectHashes:hashes,roots:context.roots});return{context,block,readiness,cdoRun,cdoHash};}
function pilotEvaluationCommand(argv:string[]):number{const operation=argv.shift();if(operation==='preflight'){const{values,json}=exactArgs(argv,['--block-id']);const blockId=values.get('--block-id');if(!json||!blockId)throw new Error('pilot_evaluation_arguments_invalid');const current=pilotReadiness(blockId);console.log(JSON.stringify({schema:'ecpe.close-state.v1',result:current.readiness.ready?'ready':'not_ready',block:{block_id:current.block.block_id,phase:current.block.phase,terminal_reason:current.block.terminal_reason,terminal_kind:current.block.terminal_kind,roots:current.block.roots},payload:{...current.readiness,cdo_run_id:current.cdoRun||null,cdo_subject_hash:current.cdoHash||null},next_operation:current.readiness.ready?'pilot_evaluation_reserve':'pilot_evaluation_preflight',error:null}));return current.readiness.ready?0:1;}if(operation==='reserve'){const{values,json}=exactArgs(argv,['--block-id','--assert-readiness']);const blockId=values.get('--block-id'),assertion=values.get('--assert-readiness');if(!json||!blockId||!assertion)throw new Error('pilot_evaluation_arguments_invalid');const current=pilotReadiness(blockId);console.log(JSON.stringify(reservePilotEvaluation({stateRoot:current.context.state.root,blockId,readiness:current.readiness,assertReadiness:assertion,cdoRunId:current.cdoRun})));return 0;}if(operation==='inspect'){const{values,json}=exactArgs(argv,['--evaluation-slot']);const slot=values.get('--evaluation-slot');if(!json||!slot)throw new Error('pilot_evaluation_arguments_invalid');const context=milestoneContext();const block=findMilestoneBlockBySlot(context.state.root,slot);console.log(JSON.stringify(inspectPilotEvaluation({stateRoot:context.state.root,blockId:block.block_id})));return 0;}if(operation==='build'){const{values,json}=exactArgs(argv,['--block-id','--evaluation-slot']);const blockId=values.get('--block-id'),slot=values.get('--evaluation-slot');if(!json||!blockId||!slot)throw new Error('pilot_evaluation_arguments_invalid');const context=milestoneContext();console.log(JSON.stringify(buildPilotEvaluation({stateRoot:context.state.root,blockId,slotId:slot})));return 0;}throw new Error('pilot_evaluation_arguments_invalid');}
function milestoneParticipantCommand(argv:string[]):number{if(argv.shift()!=='verify')throw new Error('milestone_participant_arguments_invalid');const{values,json}=exactArgs(argv,['--block-id','--evaluation-slot','--participant','--descriptor']);const blockId=values.get('--block-id'),slot=values.get('--evaluation-slot');if(!json||!blockId||!slot||values.get('--participant')!=='portfolioops'||values.get('--descriptor')!=='portfolioops.final')throw new Error('milestone_participant_arguments_invalid');const context=milestoneContext();const block=findMilestoneBlockBySlot(context.state.root,slot);if(block.block_id!==blockId)throw new Error('milestone_block_assertion_mismatch');const portfolio=resolveRegisteredProjectLocation('portfolioops',process.cwd());const result=verifyFrozenMilestoneParticipant({stateRoot:context.state.root,slotId:slot,participant:'portfolioops',repositoryRoot:portfolio.root});console.log(JSON.stringify(result));return result.disposition==='terminalized'?1:0;}
function milestoneStatusCommand(argv:string[]):number{const operation=argv.shift();let milestone=false,json=false;const values=new Map<string,string>();const allowed=new Set(['--work-kind','--finish-line','--block-id','--assert-report-path']);while(argv.length){const flag=argv.shift()!;if(flag==='--milestone'||flag==='--json'){if((flag==='--milestone'&&milestone)||(flag==='--json'&&json))throw new Error('milestone_status_arguments_invalid');if(flag==='--milestone')milestone=true;else json=true;continue}const value=argv.shift();if(!allowed.has(flag)||!value||value.startsWith('--')||values.has(flag))throw new Error('milestone_status_arguments_invalid');values.set(flag,value)}const blockId=values.get('--block-id'),finish=values.get('--finish-line')as FinishLine;if(!json||!milestone||!['prepare','prepare-partial'].includes(operation??'')||!blockId||!values.get('--work-kind')||!finish||!values.get('--assert-report-path'))throw new Error('milestone_status_arguments_invalid');const context=milestoneContext();const result=prepareMilestoneCloseout({stateRoot:context.state.root,ownerRoot:context.governance.code_root,ownerRepoId:'harness-governance',roots:context.roots,blockId,workKind:values.get('--work-kind')!,requestedFinishLine:finish,assertReportPath:values.get('--assert-report-path')!,partial:operation==='prepare-partial'});console.log(JSON.stringify(result));return 0;}

const ECPE_EVIDENCE_SUBCOMMANDS = new Set([
  'handoff',
  'handoff-inspect',
  'private-workspace',
  'safety-downgrade',
  'closeout-status',
  'recording-verify',
  'recording-binding',
  'recording-terminal',
  'safety-latch',
  'safety-profile-downgrade',
  'safety-sources',
  'safety-stop',
  'lane-promotion',
  'lane-canary',
  'milestone-block',
  'pilot-evaluation',
  'milestone-participant',
  'milestone-status',
]);

function requiresEcpeAuthorityPlatform(sub: string | undefined, argv: string[]): boolean {
  if (!sub) return false;
  const delimiter = argv.indexOf('--');
  const options = delimiter === -1 ? argv : argv.slice(0, delimiter);
  if (ECPE_EVIDENCE_SUBCOMMANDS.has(sub)) return true;
  if ((sub === 'run' || sub === 'check' || sub === 'ensure') && options.includes('--validator')) return true;
  return sub === 'check' && options.includes('--capability');
}

const [, , sub, ...rest] = process.argv;
try {
  if (requiresEcpeAuthorityPlatform(sub, rest)) assertEcpeAuthorityPlatform();
  const delimiter = rest.indexOf('--');
  const options = delimiter === -1 ? rest : rest.slice(0, delimiter);
  if ((sub === 'run' || sub === 'check' || sub === 'ensure') && options.includes('--validator')) {
    const args = profileArgs([...rest]); process.exit(sub === 'check' ? profileCheck(args) : profileEnsure(args, sub === 'run'));
  } else if (sub === "run") {
    process.exit(await cmdRun(rest));
  } else if (sub === "check") {
    process.exit(options.includes('--capability') ? await capabilityCheckCommand([...rest]) : cmdCheck(rest));
  } else if (sub === 'handoff') {
    process.exit(await handoffCommand([...rest]));
  } else if (sub === 'handoff-inspect') {
    process.exit(await handoffInspectCommand([...rest]));
  } else if (sub === 'private-workspace') {
    process.exit(privateWorkspaceCommand([...rest]));
  } else if (sub === 'safety-downgrade') {
    process.exit(safetyDowngradeCommand([...rest]));
  } else if (sub === 'closeout-status') {
    process.exit(closeoutStatusCommand([...rest]));
  } else if (sub === 'recording-verify') {
    process.exit(recordingVerifyCommand([...rest]));
  } else if (sub === 'recording-binding') {
    process.exit(recordingBindingCommand([...rest]));
  } else if (sub === 'recording-terminal') {
    process.exit(recordingTerminalCommand([...rest]));
  } else if (sub === 'safety-latch') {
    process.exit(safetyLatchCommand([...rest]));
  } else if (sub === 'safety-profile-downgrade') {
    process.exit(safetyProfileDowngradeCommand([...rest]));
  } else if (sub === 'safety-sources') {
    process.exit(await safetySourcesCommand([...rest]));
  } else if (sub === 'safety-stop') {
    process.exit(await safetyStopCommand([...rest]));
  } else if (sub === 'lane-promotion') {
    process.exit(await lanePromotionCommand([...rest]));
  } else if (sub === 'lane-canary') {
    process.exit(laneCanaryCommand([...rest]));
  } else if (sub === 'milestone-block') {
    process.exit(await milestoneBlockCommand([...rest]));
  } else if (sub === 'pilot-evaluation') {
    process.exit(pilotEvaluationCommand([...rest]));
  } else if (sub === 'milestone-participant') {
    process.exit(milestoneParticipantCommand([...rest]));
  } else if (sub === 'milestone-status') {
    process.exit(milestoneStatusCommand([...rest]));
  } else {
    console.error("usage: gstack-evidence run|check|ensure|handoff|handoff-inspect ...");
    process.exit(2);
  }
} catch (e: any) {
  // Never let the wrapper's own failure look like a command failure in a way
  // that breaks a skill flow: `run` propagates the child's code from inside
  // cmdRun; reaching here means bookkeeping blew up outside it.
  warn(`unexpected error: ${e?.message ?? e}`);
  process.exit(typeof e?.message==='string'&&/(?:arguments?|command)_invalid$/.test(e.message)?2:1);
}
