function milestoneContext() {
  const state = resolveRuntimeStateRoot(); const governance = resolveWorkspaceGovernanceLocation(process.cwd());
  const codeHeadResult = spawnSync('/usr/bin/git', ['rev-parse', 'HEAD^{commit}'], { cwd: governance.code_root, encoding: 'utf8', env: { PATH: '/usr/bin:/bin', LC_ALL: 'C', GIT_CONFIG_NOSYSTEM: '1' } }); if (codeHeadResult.status !== 0) throw new Error('milestone_code_root_invalid'); const codeHead = codeHeadResult.stdout.trim();
  const roots: MilestoneRootTuple = { code_root_id: `code-${sha256(`${governance.common_directory}\0${governance.code_root}`).slice(0, 32)}`, workspace_root_id: `workspace-${sha256(`${governance.common_directory}\0${governance.workspace_root}`).slice(0, 32)}`, state_root_id: state.stateRootId };
  return { state, governance, roots, codeHead, registryHash: sha256(readFileSync(governance.registry_path)) };
}
