#!/usr/bin/env bash
# gstack-brain-sync — drain queue, commit allowlisted paths, push to remote.
#
# Usage:
#   gstack-brain-sync --once           drain queue, commit, push (default)
#   gstack-brain-sync --status         print sync health as JSON
#   gstack-brain-sync --skip-file <p>  add <p> to ~/.gstack/.brain-skip.txt
#   gstack-brain-sync --drop-queue --yes   clear queue without committing
#   gstack-brain-sync --discover-new   scan allowlist dirs, enqueue changed files
#                                      (and removals, when publishing them is on)
#   gstack-brain-sync --list-removals  files the repo tracks that are gone from disk
#   gstack-brain-sync --publish-removals [--yes] [<path>...]
#                                      publish those removals now (dry run without --yes)
#
# Invoked by the preamble at skill START and END boundaries. No persistent
# daemon. Typical run <1s when queue empty; ~200-800ms with network push.
#
# Removals (config artifacts_sync_removals, default off): a file deleted from
# ~/.gstack, or a project directory moved by a slug migration, stays tracked
# and published until its removal is committed. With the setting on, the sync
# publishes removals too, one commit of removals only, and every machine that
# pulls loses the file. Removals that look like a loss rather than a cleanup are
# HELD for review (listed by --list-removals, published by --publish-removals):
# more than artifacts_sync_removals_max in one run, a quarter or more of the
# synced files once more than 5, every synced file of a directory that holds
# several, or any removal while a merge or rebase runs or git fails.
#
# Singleton enforcement: an atomic mkdir lock, ~/.gstack/.brain-sync.lock.d.
# --once skips when it is held (the next boundary catches up); --publish-removals exits 1.
#
# Env:
#   GSTACK_HOME — override ~/.gstack (aligns with writers).

# Heredoc delivery guard. bash 5.2+ writes a heredoc body <=64KiB through a
# pipe in the forked child before exec, with no reader on the other end. On
# macOS under pipe-KVA pressure a fresh pipe gets a 512-byte buffer, so any
# body >=512B blocks write() forever and the script hangs at startup with no
# output. Compat level 50 restores the tempfile path. These scripts are
# bash-3.2-clean, so the compat level costs them nothing. Not exported: the
# guard is per-script, and it survives `bash script.sh` call sites that
# bypass the shebang.
BASH_COMPAT=50

set -uo pipefail

GSTACK_HOME="${GSTACK_HOME:-$HOME/.gstack}"
# Maildir-style spool: one FILE per record, <epoch>-<pid>-<uniq>.json.
# Writers (gstack-brain-enqueue, --discover-new) create records via tmp-file
# + atomic rename; the drain deletes exactly the files it snapshotted. No
# shared inode between writer and drainer → no append/rewrite race.
QUEUE_DIR="$GSTACK_HOME/.brain-queue.d"
# Legacy single-file queue: kept ONLY for migration. Pre-spool writers
# appended lines here; migrate_legacy_queue converts them to spool files.
QUEUE="$GSTACK_HOME/.brain-queue.jsonl"
ALLOWLIST="$GSTACK_HOME/.brain-allowlist"
PRIVACY_MAP="$GSTACK_HOME/.brain-privacy-map.json"
SKIP_FILE="$GSTACK_HOME/.brain-skip.txt"
STATUS_FILE="$GSTACK_HOME/.brain-sync-status.json"
LAST_PUSH_FILE="$GSTACK_HOME/.brain-last-push"
LOCK_FILE="$GSTACK_HOME/.brain-sync.lock"
DISCOVER_CURSOR="$GSTACK_HOME/.brain-discover-cursor"
HELD_FILE="$GSTACK_HOME/.brain-held-removals.json"
# Why the last merge after a rejected push failed, while its commits wait.
DIVERGED_FILE="$GSTACK_HOME/.brain-sync-diverged"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG_BIN="$SCRIPT_DIR/gstack-config"

# Egress receipt helpers (_receipted_git): receipt-before-send, fail-closed.
. "$SCRIPT_DIR/gstack-egress-lib.sh"

# origin host for receipt records (github.com etc).
remote_host() {
  local url host
  url=$(git -C "$GSTACK_HOME" remote get-url origin 2>/dev/null || echo "")
  host="${url#*://}"; host="${host#*@}"; host="${host%%[/:]*}"
  echo "${host:-unknown}"
}

# Remote-specific hint for auth errors (branch on origin URL).
remote_auth_hint() {
  local url
  url=$(git -C "$GSTACK_HOME" remote get-url origin 2>/dev/null || echo "")
  case "$url" in
    *github.com*|*@github.*) echo "run: gh auth status (and gh auth refresh if needed)" ;;
    *gitlab*) echo "run: glab auth status" ;;
    *) echo "check 'git remote -v' and your credentials" ;;
  esac
}

write_status() {
  # args: status_code message [extra_json_blob]
  local code="$1"
  local msg="$2"
  local extra="${3:-{\}}"
  local ts
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "")
  python3 - "$STATUS_FILE" "$code" "$msg" "$ts" "$extra" <<'PYEOF' 2>/dev/null || true
import json, sys
path, code, msg, ts, extra = sys.argv[1:6]
try:
    extra_obj = json.loads(extra) if extra else {}
except Exception:
    extra_obj = {}
data = {"status": code, "message": msg, "ts": ts, **extra_obj}
with open(path, "w") as f:
    json.dump(data, f)
    f.write("\n")
PYEOF
}

# Read config; return 0 if sync active, 1 otherwise.
sync_active() {
  if [ ! -d "$GSTACK_HOME/.git" ]; then
    return 1
  fi
  local mode
  mode=$("$CONFIG_BIN" get artifacts_sync_mode 2>/dev/null || echo off)
  [ "$mode" = "off" ] && return 1
  return 0
}

# Secret regex families — stdin scan. Exits 0 clean, 1 if hit.
# Echoes the matching pattern family name on hit. Uses python3 -c (not
# heredoc) so sys.stdin stays available for the diff content.
secret_scan_stdin() {
  python3 -c "
import sys, re
patterns = [
    ('aws-access-key', re.compile(r'AKIA[0-9A-Z]{16}')),
    ('github-token', re.compile(r'\\b(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})')),
    ('openai-key', re.compile(r'\\bsk-[A-Za-z0-9_-]{20,}')),
    ('pem-block', re.compile(r'-----BEGIN [A-Z ]{3,}-----')),
    ('jwt', re.compile(r'\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b')),
    ('bearer-token-json',
     # JSON-embedded auth headers. The optional Bearer/Basic/Token prefix
     # matters: real auth values include a literal space after the scheme
     # name, but the value charset below does not include spaces, so
     # without the optional prefix every Bearer token in a JSON blob slips
     # past the scanner.
     re.compile(r'\"(authorization|api[_-]?key|apikey|token|secret|password)\"\\s*:\\s*\"(Bearer |Basic |Token )?[A-Za-z0-9_./+=-]{16,}\"',
                re.IGNORECASE)),
]
text = sys.stdin.read()
for name, rx in patterns:
    m = rx.search(text)
    if m:
        snippet = m.group(0)
        if len(snippet) > 30:
            snippet = snippet[:30] + '...'
        print(name + ':' + snippet)
        sys.exit(1)
sys.exit(0)
"
}

# Inventory of publishable removals, as one JSON object on stdout:
#   ok            git answered and the privacy map is readable (false: publish
#                 nothing; "error" says why)
#   pending       tracked paths gone from disk that gstack syncs today:
#                 allowlisted, not skip-listed, not .brain-* sync state, and of
#                 a privacy class the current artifacts_sync_mode publishes
#   pending_group the group of each pending path: projects/<slug> for project
#                 files, the first directory otherwise, null for a top-level file
#   busy          a merge, rebase, cherry-pick or revert is in progress
#   tracked       how many of those syncable paths the repo tracks
#   groups        the same count per group
# `ls-files --deleted` (not ls-files + a stat) keeps sparse-checkout entries
# out, and it uses lstat, so a dangling symlink is not a removal either.
# The JSON grows with the pending list, past what one argv string may hold
# (131072 bytes on Linux), so callers read it from a pipe or a file.
IFS= read -r -d '' REMOVALS_SCAN_PY <<'PYEOF' || true
import sys, os, json, fnmatch
gstack_home, allowlist_path, skip_path, privacy_path, mode = sys.argv[1:6]

def load_lines(path):
    try:
        with open(path) as f:
            return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    except FileNotFoundError:
        return []

def fail(error):
    print(json.dumps({"ok": False, "error": error, "pending": [], "pending_group": {},
                      "busy": False, "tracked": 0, "groups": {}}))
    sys.exit(0)

# The privacy rule of compute_paths_to_stage: off syncs nothing,
# artifacts-only syncs the artifact class (the first matching pattern decides,
# artifact by default), any other mode syncs everything.
try:
    with open(privacy_path) as f:
        privacy = json.load(f)
except FileNotFoundError:
    privacy = []
except ValueError:
    fail("privacy map malformed")
if not isinstance(privacy, list) or not all(isinstance(e, dict) for e in privacy):
    fail("privacy map malformed")

def mode_allows(path):
    if mode == "off":
        return False
    if mode != "artifacts-only":
        return True
    for entry in privacy:
        pat = entry.get("pattern")
        if pat and fnmatch.fnmatchcase(path, pat):
            return entry.get("class", "artifact") == "artifact"
    return True

allowlist = load_lines(allowlist_path)
skip = {s.replace(os.sep, "/") for s in load_lines(skip_path)}

def eligible(path):
    return (not path.startswith(".brain-") and path not in skip
            and any(fnmatch.fnmatchcase(path, g) for g in allowlist)
            and mode_allows(path))

def group_of(path):
    parts = path.split("/")
    if parts[0] == "projects" and len(parts) >= 3:
        return "/".join(parts[:2])
    return parts[0] if len(parts) >= 2 else None

def names(chunk):
    # A name that is not valid UTF-8 cannot travel through the JSON queue
    # records, so it is never a removal candidate (it stays published).
    out = []
    for raw in chunk:
        try:
            out.append(raw.decode("utf-8"))
        except UnicodeDecodeError:
            pass
    return out

# stdin: git dir NUL, tracked paths (each NUL-terminated), NUL, deleted
# paths (each NUL-terminated), NUL, then "OK" only if every git call succeeded.
parts = sys.stdin.buffer.read().split(b"\0")
if len(parts) < 4 or parts[-1] != b"OK" or not parts[0] or parts[-2] != b"":
    fail("git failed")
gitdir = parts[0].decode("utf-8", "surrogateescape")
body = parts[1:-2]
cut = body.index(b"") if b"" in body else -1
if cut < 0:
    fail("git failed")
tracked = [p for p in names(body[:cut]) if eligible(p)]
deleted = [p for p in names(body[cut + 1:]) if eligible(p)]

groups = {}
for p in tracked:
    g = group_of(p)
    if g is not None:
        groups[g] = groups.get(g, 0) + 1
# lexists: a path restored since git listed it is not a removal.
pending = sorted({p for p in deleted if not os.path.lexists(os.path.join(gstack_home, p))})
busy = any(os.path.exists(os.path.join(gitdir, n))
           for n in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge", "rebase-apply"))
print(json.dumps({"ok": True, "mode": mode, "pending": pending, "pending_group": {p: group_of(p) for p in pending},
                  "busy": busy, "tracked": len(tracked), "groups": groups}))
PYEOF
removals_scan() {
  if [ ! -e "$GSTACK_HOME/.git" ]; then
    echo '{"ok": false, "error": "not an artifacts repo", "pending": []}'
    return 0
  fi
  local mode gitdir
  mode=$("$CONFIG_BIN" get artifacts_sync_mode 2>/dev/null || echo off)
  gitdir=$(git -C "$GSTACK_HOME" rev-parse --absolute-git-dir 2>/dev/null) || gitdir=""
  # git runs here and streams to python, which never runs a process itself
  # (see the Windows exec invariants test).
  {
    [ -n "$gitdir" ] \
      && printf '%s\0' "$gitdir" \
      && git -C "$GSTACK_HOME" ls-files -z 2>/dev/null \
      && printf '\0' \
      && git -C "$GSTACK_HOME" ls-files -z --deleted 2>/dev/null \
      && printf '\0OK'
  } | python3 -c "$REMOVALS_SCAN_PY" "$GSTACK_HOME" "$ALLOWLIST" "$SKIP_FILE" "$PRIVACY_MAP" "$mode"
}

removals_setting() {
  local v
  v=$("$CONFIG_BIN" get artifacts_sync_removals 2>/dev/null || echo off)
  [ "$v" = "on" ] && echo on || echo off
}

# Take the run lock (an atomic mkdir; flock is not on macOS by default).
# Returns 1 while a live run holds it. A lock whose pidfile names a dead
# process is stale: it is cleared and taken, once.
take_run_lock() {
  local lock_dir="${LOCK_FILE}.d" lock_pid
  if ! mkdir "$lock_dir" 2>/dev/null; then
    # Lock dir without pidfile — treat as held; don't touch.
    [ -f "$lock_dir/pid" ] || return 1
    lock_pid=$(cat "$lock_dir/pid" 2>/dev/null || echo "")
    # Lock is held by a live process.
    if [ -z "$lock_pid" ] || kill -0 "$lock_pid" 2>/dev/null; then
      return 1
    fi
    # Stale lock — clear and retry once.
    rm -rf "$lock_dir" 2>/dev/null || true
    mkdir "$lock_dir" 2>/dev/null || return 1
  fi
  echo "$$" > "$lock_dir/pid" 2>/dev/null || true
}

# True (0) if the spool holds at least one record file.
spool_has_records() {
  local f
  for f in "$QUEUE_DIR"/*.json; do
    [ -e "$f" ] && return 0
  done
  return 1
}

# Convert one legacy queue file's lines into spool record files (tmp +
# os.replace, one file per line). Reads the file TWICE before unlinking: a
# pre-rename writer can still append through its already-open fd after our
# rename, and those appends land in the renamed file — the second pass
# NARROWS the tail-race window (transition-only: it applies to pre-spool
# writers, and a writer that appends after the second read but before the
# unlink can still lose that line; spool-native writers are immune).
# Unparseable lines migrate as-is; finalize_queue quarantines + warns on them.
convert_legacy_file() {
  local legacy="$1"
  python3 - "$legacy" "$QUEUE_DIR" <<'PYEOF' 2>/dev/null || true
import os, sys, time

legacy, spool = sys.argv[1:3]

def read_lines(path):
    try:
        with open(path) as f:
            return [l.rstrip("\r\n") for l in f if l.strip()]
    except (FileNotFoundError, OSError):
        return []

seq = 0
def write_spool(line):
    global seq
    seq += 1
    tmp = os.path.join(spool, f".tmp-{os.getpid()}-m{seq}")
    with open(tmp, "w") as f:
        f.write(line + "\n")
    os.replace(tmp, os.path.join(spool, f"{int(time.time())}-{os.getpid()}-m{seq}.json"))

written = set()
for _pass in (1, 2):   # second read closes the pre-rename-fd tail race
    for line in read_lines(legacy):
        if line not in written:   # identical duplicates collapse, as the old rewrite did
            write_spool(line)
            written.add(line)
os.unlink(legacy)
PYEOF
}

# Legacy migration (transition window only). If the single-file queue holds
# records, atomically rename it aside and convert each line to a spool file.
# A concurrent OLD writer that recreates a fresh legacy file after the rename
# simply gets migrated on the NEXT drain — nothing is lost, only deferred one
# boundary. Runs inside the run lock, before the drain reads the spool.
migrate_legacy_queue() {
  local migrating="$QUEUE.migrating"
  # Crash leftover: a prior migration renamed but died before unlink. Some of
  # its lines may already exist as spool files — re-converting duplicates is
  # safe (at-least-once; the drain dedups paths per snapshot and downstream
  # content-hash dedup absorbs re-syncs). Losing the file would not be. If
  # the conversion itself fails, the file stays for the next run (never rm a
  # non-empty .migrating file outside convert_legacy_file's own unlink).
  if [ -f "$migrating" ]; then
    if [ -s "$migrating" ]; then
      mkdir -p "$QUEUE_DIR" 2>/dev/null || return 0
      convert_legacy_file "$migrating"
    else
      rm -f "$migrating" 2>/dev/null || true
    fi
  fi
  # If the leftover STILL holds records, the conversion failed (e.g. python3
  # unavailable). The mv below would overwrite it and destroy those records —
  # exactly the never-destroy invariant above. Defer this run's migration;
  # the next run retries both files.
  [ -s "$migrating" ] && return 0
  if [ -s "$QUEUE" ]; then
    mkdir -p "$QUEUE_DIR" 2>/dev/null || return 0
    mv -f "$QUEUE" "$migrating" 2>/dev/null || return 0
    convert_legacy_file "$migrating"
  fi
  return 0
}

# Compute matched allowlisted, privacy-filtered path set from the spool.
# Output: newline-delimited relative paths that should be staged.
#
# #2549: every non-staged queue entry is CLASSIFIED, never silently discarded.
# When $2 is given, a JSON classification lands there:
#   {"retained": [privacy/mode-held paths that stay queued],
#    "dropped": {"skipped": [...], "invalid": [...], "unmatched": [...], "missing": [...]}}
# retained entries would sync if the user raises artifacts_sync_mode, so they
# stay in the queue; dropped classes can never sync (explicit skip, escape
# attempt, no allowlist glob, not on disk) and are removed WITH a counted
# status — the old behavior truncated the whole queue and reported every one
# of these, including privacy holds, as "no allowlisted changes".
#
# Spool snapshot ($3): the sorted list of spool record filenames read here is
# written to the snapshot manifest, one filename per line. finalize_queue
# deletes exactly the manifest's files and never touches records created
# after this listing — a concurrent enqueue is a separate file by
# construction, so it simply rides to the next drain.
compute_paths_to_stage() {
  local mode="$1"
  local class_file="${2:-}"
  local snapshot_file="${3:-}"
  local removals="${4:-off}"          # artifacts_sync_removals
  local removals_max="${5:-0}"        # artifacts_sync_removals_max
  local scan_file="${6:-}"            # file holding removals_scan's JSON (read when on)
  local removals_file="${7:-}"        # approved removals are written here
  python3 - "$GSTACK_HOME" "$QUEUE_DIR" "$ALLOWLIST" "$PRIVACY_MAP" "$SKIP_FILE" "$mode" "$class_file" "$snapshot_file" \
      "$removals" "$removals_max" "$scan_file" "$removals_file" "$HELD_FILE" <<'PYEOF'
import sys, json, os, fnmatch, glob

gstack_home, spool_dir, allowlist_path, privacy_path, skip_path, mode, class_file, snapshot_file = sys.argv[1:9]
removals_on = sys.argv[9] == "on"
try:
    removals_max = int(sys.argv[10])
    if removals_max < 0:
        raise ValueError
except ValueError:
    removals_max = 0          # an unreadable cap holds every removal
scan = {}
if removals_on:
    try:
        with open(sys.argv[11]) as f:
            scan = json.load(f)
    except (OSError, ValueError):
        scan = {}
    if not isinstance(scan, dict):
        scan = {}
removals_file, held_file = sys.argv[12], sys.argv[13]

def load_lines(path):
    try:
        with open(path) as f:
            return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    except FileNotFoundError:
        return []

def load_privacy_map(path):
    # Returns (entries, corrupt). Non-dict entries are filtered out
    # defensively — the map may be PULLED from the artifacts remote, so a
    # malformed entry like ["bad"] is remotely triggerable and used to raise
    # mid-classification (after the snapshot manifest was written), which the
    # old finalize turned into a full queue wipe. Any malformed shape also
    # marks the map CORRUPT: privacy classification cannot be trusted, so the
    # caller holds every queued record instead of guessing (a corrupt privacy
    # map silently treated as empty would over-share behavioral data).
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return [], False
    except json.JSONDecodeError:
        return [], True
    if not isinstance(data, list):
        return [], True
    # Expected: [{"pattern": "glob", "class": "artifact" | "behavioral"}]
    entries = [e for e in data if isinstance(e, dict)]
    return entries, len(entries) != len(data)

allowlist_globs = load_lines(allowlist_path)
privacy_map, privacy_corrupt = load_privacy_map(privacy_path)
# Normalize skip entries to the POSIX form queued paths use, so a backslash
# entry in .brain-skip.txt still matches on Windows. The drain is the safety
# boundary that actually stages files, so it must normalize identically to
# discover_new — otherwise an explicitly-skipped file gets committed.
skip_lines = {s.replace(os.sep, "/") for s in load_lines(skip_path)}

# Snapshot the spool: sorted (= chronological, filenames are epoch-first)
# list of record files at read time. Records that appear after this listing
# belong to the NEXT drain. Files we cannot read stay OUT of the manifest so
# finalize never deletes a record this drain didn't actually consume.
try:
    snapshot = sorted(n for n in os.listdir(spool_dir) if n.endswith(".json"))
except (FileNotFoundError, NotADirectoryError):
    snapshot = []

queue_paths = set()
consumed = []
for name in snapshot:
    try:
        with open(os.path.join(spool_dir, name)) as f:
            line = f.readline().strip()
    except OSError:
        continue
    consumed.append(name)
    if not line:
        continue
    try:
        obj = json.loads(line)
        p = obj.get("file")
        if isinstance(p, str):
            queue_paths.add(p)
    except json.JSONDecodeError:
        continue   # unparseable record: finalize keeps + warns

if snapshot_file:
    with open(snapshot_file, "w") as f:
        for name in consumed:
            f.write(name + "\n")

def path_matches_any(path, globs):
    for pattern in globs:
        if fnmatch.fnmatchcase(path, pattern):
            return True
    return False

def privacy_class(path, mapping):
    for entry in mapping:
        pat = entry.get("pattern")
        if pat and fnmatch.fnmatchcase(path, pat):
            return entry.get("class", "artifact")
    # Default class when no pattern matches: artifact (safe default).
    return "artifact"

# mode filter: 'off' → nothing; 'artifacts-only' → only artifact class;
# 'full' → both classes. removals_scan applies the same rule: change both.
def mode_allows(cls, mode):
    if mode == "off":
        return False
    if mode == "artifacts-only":
        return cls == "artifact"
    return True  # full

final = []
candidates = []
held = {}
classified = {"retained": [], "dropped": {"skipped": [], "invalid": [], "unmatched": [], "missing": []},
              "removed": [], "held_removals": []}
pending = set(scan.get("pending") or []) if scan.get("ok") else set()
if privacy_corrupt:
    # Fail-safe: with an untrustworthy privacy map, stage NOTHING and drop
    # NOTHING — retain every queued record until the map is fixed. The next
    # drain re-classifies from scratch.
    print("BRAIN_SYNC: warning: privacy map at " + privacy_path +
          " is malformed — holding all queued records until it is fixed", file=sys.stderr)
    classified["retained"] = sorted(queue_paths)
    queue_paths = set()
for p in sorted(queue_paths):
    if p in skip_lines:
        classified["dropped"]["skipped"].append(p)
        continue
    # Must be under GSTACK_HOME root. Reject absolute + reject ../ escape.
    if p.startswith("/") or ".." in p.split("/"):
        classified["dropped"]["invalid"].append(p)
        continue
    # Must match at least one allowlist glob.
    if not path_matches_any(p, allowlist_globs):
        classified["dropped"]["unmatched"].append(p)
        continue
    # Must survive privacy mode filter — held entries STAY QUEUED (retained):
    # they would sync under a higher artifacts_sync_mode, and reporting them
    # as "no allowlisted changes" was #2549's misattribution.
    cls = privacy_class(p, privacy_map)
    if not mode_allows(cls, mode):
        classified["retained"].append(p)
        continue
    # Not on disk: nothing to stage, unless publishing removals is on and the
    # repo tracks the path (see removals_scan). With git unreadable, hold the
    # record rather than drop it: dropping loses the removal for good.
    if not os.path.exists(os.path.join(gstack_home, p)):
        if removals_on and not scan.get("ok"):
            held[p] = "git state unreadable"
        elif removals_on and p in pending:
            candidates.append(p)
        else:
            classified["dropped"]["missing"].append(p)
        continue
    final.append(p)

# Valves: removals that look like a loss rather than a cleanup are held (they
# stay queued and are listed with a reason) until a human publishes them with
# --publish-removals. Every removal reaches every machine that pulls.
if candidates:
    groups = scan.get("groups") or {}
    tracked_total = int(scan.get("tracked") or 0)
    if scan.get("busy"):
        for p in candidates:
            held[p] = "a merge or rebase is in progress"
        candidates = []
    elif len(candidates) > removals_max:
        for p in candidates:
            held[p] = f"more than {removals_max} removals in one run"
        candidates = []
    elif len(candidates) > 5 and len(candidates) * 4 >= tracked_total:
        for p in candidates:
            held[p] = f"{len(candidates)} of {tracked_total} synced files at once"
        candidates = []
    else:
        # A directory of several synced files emptied at once looks like a
        # move or a loss (a slug migration does exactly that). A top-level
        # file, or the only file of a directory, is an ordinary delete.
        pending_group = scan.get("pending_group") or {}
        per_group = {}
        for p in candidates:
            g = pending_group.get(p)
            if g is not None:
                per_group.setdefault(g, []).append(p)
        for g, members in per_group.items():
            synced = int(groups.get(g, 0))
            if synced > 1 and len(members) >= synced:
                for p in members:
                    held[p] = f"would remove every synced file of {g}"
        candidates = [p for p in candidates if p not in held]

classified["removed"] = sorted(candidates)
classified["held_removals"] = sorted(held)
if removals_file:
    with open(removals_file, "w") as f:
        for p in classified["removed"]:
            f.write(p + "\n")
# The held list is what --list-removals and --status report. 0600: it names
# paths, like the drops sidecar.
if held:
    fd = os.open(held_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"held": held}, f, indent=1, sort_keys=True)
elif os.path.exists(held_file):
    os.unlink(held_file)

if class_file:
    with open(class_file, "w") as f:
        json.dump(classified, f)

for p in final:
    print(p)
PYEOF
}

# Finalize the drain: delete exactly the spool record files this drain
# consumed (per the snapshot manifest) AND positively classified. Deletion is
# EXPLICIT-DELETE-ONLY: a record is unlinked only when its path appears in
# (staged paths ∪ classified dropped). The old polarity ("delete unless
# retained") turned a missing/unparseable classification into retained=∅ and
# wiped every snapshotted record — remotely triggerable via a malformed
# pulled privacy map that raised AFTER the manifest write. Now a
# missing/unparseable class_file or paths_file deletes NOTHING (warn +
# return), and a path the classification never mentions stays queued.
# The predecessor (a shared-file queue rewrite) had a lockless-append race
# between its live re-read and the os.replace; with one file per record that
# race class is structurally gone — a concurrent enqueue is a separate file
# the snapshot never listed, so finalize cannot touch it. Crash semantics are
# at-least-once: a drain that dies before finalize leaves its spool files in
# place and the next run re-drains them; downstream content-hash dedup
# absorbs the duplicates. Unparseable records move to $QUEUE_DIR/quarantine/
# (never deleted) so they stop re-warning at every boundary. Dropped-path
# detail goes to a 0600 sidecar so the status line can stay content-free
# (counts only).
finalize_queue() {
  local snapshot_file="$1"  # spool filenames this drain consumed, one per line
  local class_file="$2"     # classification JSON from compute_paths_to_stage
  local paths_file="$3"     # staged paths (compute_paths_to_stage stdout), one per line
  # Fail-open by design (a failed finalize self-corrects next run: re-stage →
  # nothing-to-commit), but say so — a silent failure here would let the
  # subsequent "ok/idle" status claim a drain that did not happen.
  python3 - "$QUEUE_DIR" "$snapshot_file" "$class_file" "$paths_file" "$GSTACK_HOME/.brain-sync-drops.json" <<'PYEOF' || echo "BRAIN_SYNC: warning: queue finalize failed — entries retained; next run re-drains" >&2
import json, os, sys, time
spool_dir, snapshot_file, class_file, paths_file, drops_file = sys.argv[1:6]

def lines(path):
    try:
        with open(path) as f:
            return [l.rstrip("\r\n") for l in f if l.strip()]
    except FileNotFoundError:
        return []

# Explicit-delete-only inputs. Either input unreadable → delete NOTHING.
try:
    with open(class_file) as f:
        classified = json.load(f)
    if not isinstance(classified, dict):
        raise ValueError("classification is not an object")
except Exception:
    print("BRAIN_SYNC: warning: classification unreadable — no queue records deleted; next run re-drains", file=sys.stderr)
    sys.exit(0)
try:
    with open(paths_file) as f:
        staged = {l.strip() for l in f if l.strip()}
except Exception:
    print("BRAIN_SYNC: warning: staged-paths file unreadable — no queue records deleted; next run re-drains", file=sys.stderr)
    sys.exit(0)

dropped = set()
for group in (classified.get("dropped", {}) or {}).values():
    dropped.update(group)
deletable = staged | dropped

unparseable = 0
for name in lines(snapshot_file):
    full = os.path.join(spool_dir, name)
    try:
        with open(full) as f:
            rec = f.readline().strip()
    except OSError:
        continue                 # unreadable now: leave it for the next drain
    p = None
    try:
        p = json.loads(rec).get("file")
    except Exception:
        pass
    if not isinstance(p, str):
        # Never destroy what we can't read — but don't leave it re-warning at
        # every boundary either: move it aside for inspection.
        unparseable += 1
        try:
            qdir = os.path.join(spool_dir, "quarantine")
            os.makedirs(qdir, exist_ok=True)
            os.replace(full, os.path.join(qdir, name))
        except OSError:
            pass                 # quarantine move failed — leave in place; next run retries
        continue
    if p not in deletable:
        continue                 # retained / unclassified: stays queued (explicit-delete-only)
    try:
        os.unlink(full)          # staged or dropped: fully processed
    except FileNotFoundError:
        pass
if unparseable:
    print(f"BRAIN_SYNC: {unparseable} unparseable spool record(s) moved to quarantine (inspect {os.path.join(spool_dir, 'quarantine')})", file=sys.stderr)

if dropped:
    fd = os.open(drops_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                   "dropped": classified.get("dropped", {})}, f)
PYEOF
}

# Human-readable classification counts for status messages.
queue_summary() {
  local class_file="$1"
  python3 - "$class_file" <<'PYEOF' 2>/dev/null || echo ""
import json, sys
try:
    with open(sys.argv[1]) as f:
        c = json.load(f)
except Exception:
    print(""); sys.exit(0)
d = c.get("dropped", {}) or {}
parts = []
r = len(c.get("retained", []))
if r: parts.append(f"{r} privacy-held retained")
for k in ("skipped", "unmatched", "missing", "invalid"):
    n = len(d.get(k, []))
    if n: parts.append(f"{n} {k} dropped")
h = len(c.get("held_removals", []) or [])
if h: parts.append(f"{h} removal(s) held for review (gstack-brain-sync --list-removals)")
print("; ".join(parts))
PYEOF
}

# "N file(s)", "R removal(s)", or both: what a drain committed.
drain_what() {
  if [ "$2" -eq 0 ]; then
    echo "$1 file(s)"
  elif [ "$1" -eq 0 ]; then
    echo "$2 removal(s)"
  else
    echo "$1 file(s) and $2 removal(s)"
  fi
}

# The held-removal part of the classification alone, for success messages.
held_removals_note() {
  python3 - "$1" <<'PYEOF' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1]) as f:
        h = len(json.load(f).get("held_removals", []) or [])
except Exception:
    h = 0
if h:
    print(f"{h} removal(s) held for review (gstack-brain-sync --list-removals)")
PYEOF
}

# 0 when the removals staged in the index (GIT_INDEX_FILE when set) are
# exactly the paths listed in $1, one per line. With "strict" as $2, nothing
# else may be staged either. Renames are listed as a removal plus an addition.
IFS= read -r -d '' STAGED_EXACTLY_PY <<'PYEOF' || true
import sys
approved_file, strict = sys.argv[1], sys.argv[2]
with open(approved_file) as f:
    approved = {l.rstrip("\r\n") for l in f if l.strip()}
parts = [x.decode("utf-8", "surrogateescape") for x in sys.stdin.buffer.read().split(b"\0") if x]
entries = [(parts[i], parts[i + 1]) for i in range(0, len(parts) - 1, 2)]
if strict and any(status != "D" for status, _ in entries):
    sys.exit(1)
staged = {path for status, path in entries if status == "D"}
sys.exit(0 if staged == approved else 1)
PYEOF
removals_staged_exactly() {
  git -C "$GSTACK_HOME" diff --cached --no-renames --name-status -z 2>/dev/null \
    | python3 -c "$STAGED_EXACTLY_PY" "$1" "${2:-}"
}

# Commit the removal of exactly the paths listed in $1 (one per line) on top of
# HEAD, from a private index. The commit can only remove: it never reads the
# working tree, so a file that comes back meanwhile is not published by it.
# That is also why it skips the pre-commit hook: a hook written before removal
# support scans the removed text and would refuse the commit forever.
# The private index lives in the git dir (the run lock makes it ours), so an
# interrupted run leaves nothing in /tmp. On failure, prints git's reason.
commit_removals() {
  local list="$1" msg="$2" gitdir idx err rc=1
  if ! gitdir=$(git -C "$GSTACK_HOME" rev-parse --absolute-git-dir 2>&1); then
    printf '%s\n' "$gitdir" | sed -n '/./{p;q;}' | cut -c1-200
    return 1
  fi
  idx="$gitdir/brain-sync-removals.index"
  rm -f "$idx"
  if ! err=$(GIT_INDEX_FILE="$idx" git -C "$GSTACK_HOME" read-tree HEAD 2>&1); then
    :
  elif ! err=$(tr -d '\r' < "$list" | tr '\n' '\0' \
      | GIT_INDEX_FILE="$idx" git -C "$GSTACK_HOME" update-index --force-remove -z --stdin 2>&1); then
    :
  elif ! GIT_INDEX_FILE="$idx" removals_staged_exactly "$list" strict; then
    err="the removal index does not match the approved list"
  elif ! err=$(GIT_INDEX_FILE="$idx" git -C "$GSTACK_HOME" -c user.email="gstack@localhost" -c user.name="gstack-brain-sync" \
      commit -q --no-verify -m "$msg" 2>&1); then
    :
  else
    rc=0
  fi
  rm -f "$idx"
  [ "$rc" -eq 0 ] || printf '%s\n' "${err:-no message}" | sed -n '/./{p;q;}' | cut -c1-200
  return "$rc"
}

# Restore the index entries of the paths listed in the given files (one per
# line) to HEAD: undoes this drain's staging, additions and removals alike.
# One literal path at a time: reading pathspecs from a file needs git 2.25+.
unstage_listed() {
  local list p
  for list in "$@"; do
    [ -s "$list" ] || continue
    while IFS= read -r p || [ -n "$p" ]; do
      p="${p%$'\r'}"
      [ -z "$p" ] && continue
      GIT_LITERAL_PATHSPECS=1 git -C "$GSTACK_HOME" reset -q HEAD -- "$p" >/dev/null 2>&1 || true
    done < "$list"
  done
}

# `git ls-files -u -z` on stdin ("<mode> <oid> <stage>TAB<path>" entries).
# Exits 1, printing nothing, unless EVERY unmerged path is a modify/delete
# conflict: the common base (stage 1) plus exactly one side (2 or 3). With
# "paths", prints those paths, one per line; with "index-info", a stage-0
# entry per path holding the side that kept the file, for
# `update-index -z --index-info`.
IFS= read -r -d '' MODIFY_DELETE_PY <<'PYEOF' || true
import sys
entries = {}
for rec in sys.stdin.buffer.read().split(b"\0"):
    if not rec:
        continue
    meta, path = rec.split(b"\t", 1)
    fmode, oid, stage = meta.split(b" ")
    entries.setdefault(path, {})[int(stage)] = (fmode, oid)
if not entries or not all(set(s) in ({1, 2}, {1, 3}) for s in entries.values()):
    sys.exit(1)
if sys.argv[1] == "paths":
    for path in entries:
        sys.stdout.buffer.write(path + b"\n")
else:
    for path, stages in entries.items():
        fmode, oid = stages.get(2) or stages[3]
        sys.stdout.buffer.write(fmode + b" " + oid + b" 0\t" + path + b"\0")
PYEOF

# After a failed merge: when EVERY unmerged path is a modify/delete conflict
# (edited on one side, removed on the other), keep the edited file and
# conclude the merge, printing the kept paths. The kept content is the
# side's recorded blob, never the working tree, so the merge publishes only
# what this machine committed (and scanned) or the remote already holds; a
# later local write stays for the next drain. --no-verify: the merge brings in
# the remote's changes, which an old hook could refuse forever. Returns 1 for
# any other kind of conflict, and the caller aborts the merge.
resolve_modify_delete() {
  local kept
  kept=$(git -C "$GSTACK_HOME" ls-files -u -z 2>/dev/null | python3 -c "$MODIFY_DELETE_PY" paths) || return 1
  git -C "$GSTACK_HOME" ls-files -u -z 2>/dev/null | python3 -c "$MODIFY_DELETE_PY" index-info \
    | git -C "$GSTACK_HOME" update-index -z --index-info >/dev/null 2>&1 || return 1
  git -C "$GSTACK_HOME" -c user.email="gstack@localhost" -c user.name="gstack-brain-sync" \
    commit -q --no-verify --no-edit >/dev/null 2>&1 || return 1
  printf '%s\n' "$kept"
}

# EXIT-trap helper for a run stopped between staging and committing: put the
# listed paths back to HEAD in the index, and drop a private removal index
# commit_removals may have left.
abandon_staging() {
  local g
  unstage_listed "$@"
  g=$(git -C "$GSTACK_HOME" rev-parse --absolute-git-dir 2>/dev/null) && rm -f "$g/brain-sync-removals.index"
  return 0
}

# The line of a failed push's stderr that says why ("! [rejected] ...",
# "error: ..."), else its first line.
push_reason() {
  local line
  line=$(printf '%s\n' "$1" | grep -m1 -E '^ *(!|error:|fatal:)' || true)
  [ -n "$line" ] || line=$(printf '%s\n' "$1" | sed -n '/./{p;q;}')
  printf '%s' "$line" | sed 's/^ *//' | cut -c1-200
}

# After a rejected push: fetch, merge the remote (merge drivers handle JSONL
# and markdown; resolve_modify_delete keeps an edit over a removal) and push
# again. The fetch and the retry push are their own attempted-egress ops, each
# receipted fail-closed. Returns 0 when the retry landed, 2 when the merge
# failed (aborted; MERGE_REASON says why), 1 otherwise. MERGE_KEPT_LIST names
# the files kept over a removal (MERGE_KEPT counts them); MERGE_MOVED is 1
# when the merge brought anything in.
MERGE_KEPT=""
MERGE_KEPT_LIST=""
MERGE_REASON=""
MERGE_MOVED=0
merge_and_retry_push() {
  local host="$1" branch merge_err before
  MERGE_KEPT=""
  MERGE_KEPT_LIST=""
  MERGE_REASON=""
  MERGE_MOVED=0
  GSTACK_HOME="$GSTACK_HOME" _receipted_git closed brain-sync "$host" curated-memory-git-fetch "artifacts_sync_mode!=off" \
    bash -c 'GIT_TERMINAL_PROMPT=0 git -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=30 -C "$1" fetch origin 2>/dev/null' _ "$GSTACK_HOME" || return 1
  branch=$(git -C "$GSTACK_HOME" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
  before=$(git -C "$GSTACK_HOME" rev-parse HEAD 2>/dev/null || true)
  # The merge commit is the sync's own, like its other commits (and a
  # machine with no git identity could not merge at all).
  if ! merge_err=$(git -C "$GSTACK_HOME" -c user.email="gstack@localhost" -c user.name="gstack-brain-sync" \
      merge --no-edit "origin/$branch" 2>&1 >/dev/null); then
    # A removal on one machine and an edit on another is a modify/delete
    # conflict, which no merge driver sees. Keep the edit. Any other
    # failure is aborted, so no half-done merge blocks later commits.
    if ! MERGE_KEPT_LIST=$(resolve_modify_delete); then
      MERGE_KEPT_LIST=""
      MERGE_REASON=$(git -C "$GSTACK_HOME" diff --name-only --diff-filter=U 2>/dev/null | sed -n '1,3p' | tr '\n' ',' | sed 's/,$//; s/,/, /g')
      if [ -n "$MERGE_REASON" ]; then
        MERGE_REASON="conflict in $MERGE_REASON"
      else
        MERGE_REASON="merge failed: $(printf '%s' "$merge_err" | sed -n '/./{p;q;}' | cut -c1-200)"
      fi
      git -C "$GSTACK_HOME" merge --abort >/dev/null 2>&1 || true
      printf '%s\n' "$MERGE_REASON" > "$DIVERGED_FILE" 2>/dev/null || true
      return 2
    fi
    MERGE_KEPT=$(printf '%s\n' "$MERGE_KEPT_LIST" | grep -c . || true)
  fi
  [ "$(git -C "$GSTACK_HOME" rev-parse HEAD 2>/dev/null || true)" != "$before" ] && MERGE_MOVED=1
  GSTACK_HOME="$GSTACK_HOME" _receipted_git closed brain-sync "$host" curated-memory-git-push "artifacts_sync_mode!=off" \
    bash -c 'GIT_TERMINAL_PROMPT=0 git -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=30 -C "$1" push origin HEAD 2>/dev/null' _ "$GSTACK_HOME" || return 1
  rm -f "$DIVERGED_FILE"
}

# The status of a run that pushed nothing ($1), naming commits still waiting
# to land on branch $2: the last merge after a rejected push failed (its
# reason is kept in DIVERGED_FILE until the commits land), or they wait for
# the run-start detector's next attempt, or, when not all are
# gstack-brain-sync's own (the detector never pushes those), for the next
# synced change. Files a detector merge kept over a removal are named too.
DET_MRC=0
report_idle() {
  local msg="$1$(kept_note)" branch="$2" total="" bot=""
  if [ -n "$branch" ]; then
    total=$(git -C "$GSTACK_HOME" rev-list --count "origin/$branch..HEAD" 2>/dev/null || true)
    bot=$(git -C "$GSTACK_HOME" rev-list --count --author="gstack-brain-sync" "origin/$branch..HEAD" 2>/dev/null || true)
  fi
  case "$total" in
    ''|*[!0-9]*) write_status "idle" "$msg" ;;
    0)
      rm -f "$DIVERGED_FILE"
      write_status "idle" "$msg"
      ;;
    *)
      if [ -s "$DIVERGED_FILE" ]; then
        write_status "push_failed" "diverged from the remote ($(head -1 "$DIVERGED_FILE")); merge aborted, $total commit(s) kept locally. $(resolve_hint)"
      elif [ "$bot" = "$total" ]; then
        write_status "push_failed" "$msg; $total local commit(s) not on the remote yet (retried every 10 minutes)"
      else
        write_status "idle" "$msg; $total local commit(s) not on the remote yet, not all gstack-brain-sync's own: they go out with the next synced change"
      fi
      ;;
  esac
}

# What to do about a merge the sync aborted.
resolve_hint() {
  echo "Resolve in $GSTACK_HOME: git merge origin/<branch>, fix the conflict, commit, git push"
}

# The status suffix for files merge_and_retry_push kept over a removal.
kept_note() {
  [ -n "$MERGE_KEPT" ] && [ "$MERGE_KEPT" != "0" ] && echo "; kept $MERGE_KEPT file(s) that one side edited and the other removed"
  return 0
}

# Commit what the drain staged: approved removals first, in a commit of their
# own, then everything else. Appends the finished paths to $done_file. Returns
# 1 when nothing needed committing; on a refusal it reports and EXITS.
commit_drain() {
  local paths_file="$1" removals_file="$2" done_file="$3" snapshot_file="$4" class_file="$5"
  local n="$6" r="$7" ts="$8" made=0
  # Removals first, in a commit of their own (commit_removals). The index
  # already holds them too, so the commit below carries additions only.
  if [ "$r" -gt 0 ]; then
    local why_rm
    if ! why_rm=$(commit_removals "$removals_file" "sync: remove $r file(s) | $ts"); then
      unstage_listed "$paths_file" "$removals_file"
      write_status "blocked" "removal commit failed (${why_rm:-no message}); nothing committed (queue preserved)"
      echo "BRAIN_SYNC: blocked: removal commit failed: ${why_rm:-no message}" >&2
      exit 0
    fi
    made=1
    cat "$removals_file" >> "$done_file"
  fi

  # Commit with template message.
  if [ "$n" -gt 0 ] && ! git -C "$GSTACK_HOME" diff --cached --quiet 2>/dev/null; then
    local commit_err
    if ! commit_err=$(git -C "$GSTACK_HOME" -c user.email="gstack@localhost" -c user.name="gstack-brain-sync" \
        commit -q -m "sync: $n file(s) | $ts" 2>&1); then
      # A REFUSED commit (the defense-in-depth pre-commit hook, a signing
      # failure) is not "nothing to commit": finalizing would drop these
      # records while their changes stay staged, and that staged diff would
      # refuse every later commit. Unstage what this drain staged, keep those
      # records; removals already committed leave the spool and the run-start
      # detector pushes their commit.
      unstage_listed "$paths_file"
      finalize_queue "$snapshot_file" "$class_file" "$done_file"
      local why
      why=$(printf '%s' "$commit_err" | head -1 | cut -c1-200)
      write_status "blocked" "commit refused (${why:-no message}); changes unstaged, queue preserved"
      echo "BRAIN_SYNC: blocked: commit refused: ${why:-no message}" >&2
      exit 0
    fi
    made=1
  fi
  cat "$paths_file" >> "$done_file"
  [ "$made" -eq 1 ]
}

subcmd_once() {
  if ! sync_active; then
    # Silent no-op when feature not initialized / disabled.
    exit 0
  fi

  # Singleton lock (take_run_lock). If another --once is already running,
  # skip (don't wait) — the next skill boundary will catch up.
  local lock_dir="${LOCK_FILE}.d"
  take_run_lock || exit 0
  # Release the lock on EVERY exit from here on — including the empty-queue
  # fast path and an INT during the detector's network push. Leaking it would
  # rely on next-run stale-pid detection, which PID reuse can defeat (kill -0
  # matching an unrelated live process wedges sync at every boundary). The
  # mktemp block below re-traps with tempfile cleanup added; both traps keep
  # the lock removal. INT and TERM END the run (the EXIT trap then cleans up):
  # a handler that cleaned up and returned let the run go on without its lock
  # and its temp files.
  trap 'trap "" INT TERM; rm -rf "$lock_dir" 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  # Convert any legacy single-file queue lines into spool records before the
  # drain reads the spool (transition window for pre-spool writers).
  migrate_legacy_queue

  # Janitor: reap orphaned enqueue temp files. A writer killed between its
  # tmp write and the atomic rename leaves `.tmp-*` behind forever — it never
  # becomes a record and nothing else touches it. One hour is far beyond any
  # live writer's write→rename window, so a fresh tmp (an in-flight enqueue)
  # is never touched. Runs inside the run lock, so it can't race the drain.
  find "$QUEUE_DIR" -maxdepth 1 -type f -name '.tmp-*' -mmin +60 -delete 2>/dev/null || true

  local mode
  mode=$("$CONFIG_BIN" get artifacts_sync_mode 2>/dev/null || echo off)

  # #2516: advance the brain worktree gbrain indexes to the artifacts repo's
  # HEAD once a day — previously it only moved when setup-gbrain / sync-gbrain
  # / brain-restore ran, so brains silently served stale code forever. Runs
  # inside THIS run lock (never concurrent with the ingest steps below) and
  # before they touch the worktree. Attempt-throttled: the stamp is written on
  # ATTEMPT, so a persistently-failing advance warns once per 24h, not at
  # every skill boundary. The advance itself refuses dirty or unmanaged
  # worktrees and never force-removes (see gstack-gbrain-source-wireup).
  if [ -e "${GSTACK_BRAIN_WORKTREE:-$HOME/.gstack-brain-worktree}" ]; then
    local adv_stamp adv_now adv_last adv_age
    adv_stamp="$GSTACK_HOME/.brain-worktree-last-advance"
    adv_now=$(date +%s)
    adv_last=$(cat "$adv_stamp" 2>/dev/null || echo 0)
    case "$adv_last" in ''|*[!0-9]*) adv_last=0 ;; esac
    adv_age=$(( adv_now - adv_last ))
    if [ "$adv_age" -ge 86400 ]; then
      echo "$adv_now" > "$adv_stamp" 2>/dev/null || true
      if ! "$SCRIPT_DIR/gstack-gbrain-source-wireup" --advance-only 1>&2; then
        echo "BRAIN_SYNC: warning: brain worktree advance failed — gbrain may be indexing stale code (run gstack-gbrain-source-wireup to repair)" >&2
      fi
    fi
  fi

  # #2549 unpushed-commit detector: a prior drain may have COMMITTED but
  # failed to push (auth blip, offline). The data was never lost — it sits in
  # a local commit — but nothing re-pushed it until NEW changes arrived.
  # Retry the push up front, inside the lock. Receipted fail-closed like
  # every other push; a receipt REFUSAL skips the retry without blocking the
  # rest of the drain (local staging must not wedge on receipt problems).
  # Guards: origin/<branch> may not exist yet (first sync, deleted remote).
  #
  # Throttled: the preamble runs --once at EVERY skill boundary, so an
  # unthrottled retry would pay a full network push attempt per boundary in
  # exactly the steady states this targets (offline, broken auth) — and a
  # captive-portal push can block 30-75s against the header's "<1s when
  # idle" promise. Attempts are recorded (success or fail) and retried at
  # most every 10 minutes; the push itself never prompts for credentials and
  # bounds stalled transfers via git's own low-speed limits (portable — stock
  # macOS ships no `timeout` binary).
  #
  # Author-scoped — EXCLUSIVELY: `git push origin HEAD` publishes every
  # unpushed commit, so the retry fires only when ALL unpushed commits are
  # gstack-brain-sync's own. One interleaved user commit disables the
  # auto-retry entirely (adversarial review: an existential check would
  # silently auto-publish a user's manual ~/.gstack commit the moment a bot
  # commit sat in front of it). User commits ride along when a REAL drain
  # pushes, as before — the detector never publishes work it didn't create.
  local det_branch det_unpushed det_total det_now det_last
  det_branch=$(git -C "$GSTACK_HOME" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  # Detached HEAD reads as the literal "HEAD" — origin/HEAD usually resolves,
  # so without this exclusion the detector would retry a doomed push forever.
  [ "$det_branch" = "HEAD" ] && det_branch=""
  if [ -n "$det_branch" ] && git -C "$GSTACK_HOME" rev-parse --verify --quiet "origin/$det_branch" >/dev/null 2>&1; then
    det_unpushed=$(git -C "$GSTACK_HOME" rev-list --count --author="gstack-brain-sync" "origin/$det_branch..HEAD" 2>/dev/null || echo 0)
    det_total=$(git -C "$GSTACK_HOME" rev-list --count "origin/$det_branch..HEAD" 2>/dev/null || echo 0)
    case "$det_unpushed" in ''|*[!0-9]*) det_unpushed=0 ;; esac
    case "$det_total" in ''|*[!0-9]*) det_total=0 ;; esac
    det_now=$(date +%s)
    det_last=$(cat "$GSTACK_HOME/.brain-last-push-attempt" 2>/dev/null || echo 0)
    case "$det_last" in ''|*[!0-9]*) det_last=0 ;; esac
    if [ "$det_unpushed" -gt 0 ] && [ "$det_unpushed" -eq "$det_total" ] && [ $(( det_now - det_last )) -ge 600 ]; then
      echo "$det_now" > "$GSTACK_HOME/.brain-last-push-attempt" 2>/dev/null || true
      local det_host
      det_host=$(remote_host)
      local det_rc=0
      GSTACK_HOME="$GSTACK_HOME" _receipted_git closed brain-sync "$det_host" curated-memory-git-push "artifacts_sync_mode!=off" \
        bash -c 'GIT_TERMINAL_PROMPT=0 git -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=30 -C "$1" push origin HEAD 2>/dev/null' _ "$GSTACK_HOME" || det_rc=$?
      # A rejected retry (git exits 1: another machine pushed first, or a run
      # stopped before its merge) is merged and retried as the drain does;
      # otherwise these commits would wait for the next change. Other
      # failures (unreachable, auth: 128; receipt refused: 3) are not.
      if [ "$det_rc" -eq 1 ]; then
        merge_and_retry_push "$det_host" || DET_MRC=$?
        [ "$DET_MRC" -eq 2 ] && echo "BRAIN_SYNC: push failed: diverged: $MERGE_REASON" >&2
      fi
      if [ "$det_rc" -eq 0 ] || { [ "$det_rc" -eq 1 ] && [ "$DET_MRC" -eq 0 ]; }; then
        date -u +%Y-%m-%dT%H:%M:%SZ > "$LAST_PUSH_FILE"
        rm -f "$DIVERGED_FILE"
      fi
    fi
  fi

  # Empty-queue fast path: this is the steady state at every skill boundary.
  # Skipping compute/finalize here is safe — with zero spool records there is
  # nothing to classify, retain, or drop, and a record created after this
  # check simply waits for the next boundary. The legacy file is checked too:
  # an OLD writer may have recreated it after the migration above (it gets
  # migrated next run, but the depth is honest now) — and so is a leftover
  # .migrating file: if its conversion failed above (e.g. python3 missing),
  # records are still pending, so "idle" would be dishonest. (The detector
  # above already ran: its whole point is re-pushing stranded commits when
  # the queue is empty.) The lock-release trap installed at acquisition
  # covers this exit.
  if ! spool_has_records && [ ! -s "$QUEUE" ] && [ ! -s "$QUEUE.migrating" ]; then
    # Held removals are queued records, so nothing is held either.
    rm -f "$HELD_FILE"
    report_idle "queue empty" "$det_branch"
    exit 0
  fi

  local paths_file class_file snapshot_file removals_file done_file scan_file staged=0
  paths_file=$(mktemp /tmp/brain-sync-paths.XXXXXX) || { rm -rf "$lock_dir" 2>/dev/null; write_status "error" "mktemp failed"; exit 1; }
  class_file=$(mktemp /tmp/brain-sync-class.XXXXXX) || { rm -f "$paths_file"; rm -rf "$lock_dir" 2>/dev/null; write_status "error" "mktemp failed"; exit 1; }
  snapshot_file=$(mktemp /tmp/brain-sync-snapshot.XXXXXX) || { rm -f "$paths_file" "$class_file"; rm -rf "$lock_dir" 2>/dev/null; write_status "error" "mktemp failed"; exit 1; }
  removals_file=$(mktemp /tmp/brain-sync-removals.XXXXXX) || { rm -f "$paths_file" "$class_file" "$snapshot_file"; rm -rf "$lock_dir" 2>/dev/null; write_status "error" "mktemp failed"; exit 1; }
  done_file=$(mktemp /tmp/brain-sync-done.XXXXXX) || { rm -f "$paths_file" "$class_file" "$snapshot_file" "$removals_file"; rm -rf "$lock_dir" 2>/dev/null; write_status "error" "mktemp failed"; exit 1; }
  scan_file=$(mktemp /tmp/brain-sync-scan.XXXXXX) || { rm -f "$paths_file" "$class_file" "$snapshot_file" "$removals_file" "$done_file"; rm -rf "$lock_dir" 2>/dev/null; write_status "error" "mktemp failed"; exit 1; }
  # Single trap covers all: lock cleanup AND tempfile cleanup. A run stopped
  # between staging and committing first unstages what it staged (staged=1),
  # so the next run starts from the index it would have left.
  trap 'trap "" INT TERM; [ "$staged" = 1 ] && abandon_staging "$paths_file" "$removals_file"; rm -f "$paths_file" "$class_file" "$snapshot_file" "$removals_file" "$done_file" "$scan_file" 2>/dev/null; rm -rf "$lock_dir" 2>/dev/null || true' EXIT

  # Removal inventory, only when publishing removals is on (removals_scan).
  local removals removals_max
  removals=$(removals_setting)
  removals_max=$("$CONFIG_BIN" get artifacts_sync_removals_max 2>/dev/null || echo 0)
  if [ "$removals" = "on" ]; then
    removals_scan > "$scan_file" 2>/dev/null || echo '{"ok": false, "error": "git failed"}' > "$scan_file"
  fi

  # Fail-safe (G1): a classifier that dies mid-run (ENOSPC/OOM/SIGKILL, or a
  # shape the defensive filters don't cover) may have already written the
  # snapshot manifest but no classification. Finalizing on that state is what
  # used to wipe the queue — so on a nonzero exit, warn loudly, do NOT call
  # finalize_queue, and leave everything queued for the next drain.
  if ! compute_paths_to_stage "$mode" "$class_file" "$snapshot_file" \
      "$removals" "$removals_max" "$scan_file" "$removals_file" > "$paths_file"; then
    echo "BRAIN_SYNC: warning: queue classification failed — no records consumed; next run re-drains" >&2
    write_status "error" "classification failed; queue preserved (next run retries)"
    exit 0
  fi
  if [ ! -s "$paths_file" ] && [ ! -s "$removals_file" ]; then
    # Nothing stageable. Finalize the snapshot (retained and held entries
    # survive; classified drops removed; records created after the snapshot
    # untouched).
    finalize_queue "$snapshot_file" "$class_file" "$paths_file"
    local summary
    summary=$(queue_summary "$class_file")
    report_idle "no stageable changes${summary:+ ($summary)}" "$det_branch"
    exit 0
  fi

  # Stage with git add -f (forces past .gitignore=*) explicit paths only.
  # GIT_LITERAL_PATHSPECS: a queued name is a path, never a pattern, so a `*`,
  # `?`, `[` or leading `:` in a file name cannot stage other files.
  # --ignore-removal: a queued file deleted since classification is not
  # staged as a removal here; only approved removals are, below.
  local p
  staged=1
  while IFS= read -r p; do
    p="${p%$'\r'}"   # Windows: compute_paths_to_stage's python print() emits CRLF;
                     # a trailing CR makes the pathspec match nothing (silent no-stage).
    [ -z "$p" ] && continue
    GIT_LITERAL_PATHSPECS=1 git -C "$GSTACK_HOME" add -f --ignore-removal -- "$p" 2>/dev/null || true
  done < "$paths_file"
  # An approved removal (tracked, gone from disk): git add stages the removal.
  while IFS= read -r p; do
    p="${p%$'\r'}"
    [ -z "$p" ] && continue
    GIT_LITERAL_PATHSPECS=1 git -C "$GSTACK_HOME" add -f -- "$p" 2>/dev/null || true
  done < "$removals_file"

  # With removals on, the staged removals must be exactly the approved ones:
  # one staged by hand would bypass the valves, and an approved one whose file
  # came back is not a removal any more. (With the setting off, a removal
  # staged by hand is committed as it always was.)
  if [ "$removals" = "on" ] && ! removals_staged_exactly "$removals_file"; then
    unstage_listed "$paths_file" "$removals_file"
    staged=0
    write_status "blocked" "staged removals differ from the approved set; nothing committed (queue preserved)"
    echo "BRAIN_SYNC: blocked: staged removals differ from the approved set" >&2
    exit 0
  fi

  # Secret-scan the staged diff. Pure removals are excluded (--diff-filter=d):
  # they publish no bytes, and scanning their old text would refuse, forever,
  # the removal of an already-published file that matches a pattern.
  # --no-renames: a removal staged with a similar new file would otherwise
  # show as a rename, whose diff omits the new file's content.
  local scan_out
  scan_out=$(git -C "$GSTACK_HOME" diff --cached --no-renames --diff-filter=d 2>/dev/null | secret_scan_stdin || true)
  if [ -n "$scan_out" ]; then
    # Hit — unstage, preserve queue, write loud status.
    git -C "$GSTACK_HOME" reset HEAD -- . >/dev/null 2>&1 || true
    staged=0
    local hint
    hint="secret pattern detected ($scan_out). Remediation: review the staged file, then run: gstack-brain-sync --skip-file <path> OR edit the content."
    write_status "blocked" "$hint"
    echo "BRAIN_SYNC: blocked: $scan_out" >&2
    exit 0
  fi

  local n r ts what held_note
  n=$(grep -c . "$paths_file" || true)
  r=$(grep -c . "$removals_file" || true)
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  what=$(drain_what "$n" "$r")
  held_note=$(held_removals_note "$class_file")

  # Egress receipt for the push, written BEFORE the commit consumes the
  # queue (amendment C7 ordering): a refused receipt exits HERE, before any
  # queue mutation or local commit, so the queue stays intact and the next
  # run retries the whole drain. Content-free: git owns the bytes
  # (sha256:null). Fail-closed.
  local push_host receipt_err
  push_host=$(remote_host)
  if ! receipt_err=$(GSTACK_HOME="$GSTACK_HOME" "$SCRIPT_DIR/gstack-egress-receipt" write \
      --sink brain-sync --host "$push_host" --class curated-memory-git-push \
      --no-payload --consent "artifacts_sync_mode!=off" 2>&1 >/dev/null); then
    unstage_listed "$paths_file" "$removals_file"
    staged=0
    write_status "push_failed" "EGRESS_RECEIPT_FAILED: receipt not writable; push refused (queue preserved)"
    _gstack_egress_refusal "brain-sync push" "$(printf '%s' "$receipt_err" | head -c 300)"
    exit 1
  fi

  if ! commit_drain "$paths_file" "$removals_file" "$done_file" "$snapshot_file" "$class_file" "$n" "$r" "$ts"; then
    # Nothing to commit (e.g. all files already committed). The drained
    # records leave the spool; retained + post-snapshot records survive.
    staged=0
    finalize_queue "$snapshot_file" "$class_file" "$done_file"
    report_idle "queue drained but no new changes to commit" "$det_branch"
    exit 0
  fi

  staged=0

  # Push. On reject, fetch + merge (merge driver handles JSONL) + retry once.
  local push_err
  push_err=$(git -C "$GSTACK_HOME" push origin HEAD 2>&1 >/dev/null) || {
    # Check if this is an auth error first — no point retrying.
    if echo "$push_err" | grep -qiE "auth|permission|403|401|forbidden"; then
      local hint
      hint=$(remote_auth_hint)
      write_status "push_failed" "push failed: auth error; commit retained locally, will retry next run. fix: $hint"
      echo "BRAIN_SYNC: push failed: auth. fix: $hint" >&2
      # Drained records leave the spool — they live in the local commit, which
      # the run-start detector re-pushes next time (#2549). Retained +
      # post-snapshot records survive the finalize.
      finalize_queue "$snapshot_file" "$class_file" "$done_file"
      exit 0
    fi

    # Try a fetch-and-merge + retry (merge_and_retry_push).
    local mrc=0
    merge_and_retry_push "$push_host" || mrc=$?
    if [ "$mrc" -eq 0 ]; then
      finalize_queue "$snapshot_file" "$class_file" "$done_file"
      date -u +%Y-%m-%dT%H:%M:%SZ > "$LAST_PUSH_FILE"
      local how=""
      [ "$MERGE_MOVED" = 1 ] && how=" after merging the remote's changes"
      write_status "ok" "pushed $what$how$(kept_note)${held_note:+ ($held_note)}"
      exit 0
    fi
    if [ "$mrc" -eq 2 ]; then
      write_status "push_failed" "diverged from the remote ($MERGE_REASON); merge aborted, commits kept locally. $(resolve_hint)"
      echo "BRAIN_SYNC: push failed: diverged: $MERGE_REASON" >&2
      finalize_queue "$snapshot_file" "$class_file" "$done_file"
      exit 0
    fi
    # Commit exists locally; the run-start detector re-pushes it next time.
    write_status "push_failed" "push failed: $(push_reason "$push_err"); commit retained locally, will retry next run"
    finalize_queue "$snapshot_file" "$class_file" "$done_file"
    exit 0
  }

  # Success: drained records leave the spool (retained + post-snapshot survive).
  rm -f "$DIVERGED_FILE"
  finalize_queue "$snapshot_file" "$class_file" "$done_file"
  date -u +%Y-%m-%dT%H:%M:%SZ > "$LAST_PUSH_FILE"
  write_status "ok" "pushed $what${held_note:+ ($held_note)}"
  exit 0
}

IFS= read -r -d '' STATUS_FIELDS_PY <<'PYEOF' || true
import json, sys
held_path, setting = sys.argv[1:3]
try:
    scan = json.load(sys.stdin)
except ValueError:
    scan = {}
ok = isinstance(scan, dict) and scan.get("ok") and scan.get("mode") != "off"
pending = set(scan.get("pending") or []) if ok else None
try:
    with open(held_path) as f:
        held = set(json.load(f).get("held", {}))
except (OSError, ValueError, AttributeError, TypeError):
    held = set()
print(json.dumps({"removals": setting,
                  "removals_pending": None if pending is None else len(pending),
                  "removals_held": 0 if pending is None else len(held & pending)})[1:-1])
PYEOF

subcmd_status() {
  if [ -f "$STATUS_FILE" ]; then
    cat "$STATUS_FILE"
  else
    echo '{"status":"unknown","message":"no status file yet"}'
  fi
  # Supplemental info (not in status file). Depth = spool record files plus
  # any not-yet-migrated legacy queue lines (transition window), including a
  # crash-leftover .migrating file — its records are still pending too.
  local queue_depth spool_depth legacy_depth
  spool_depth=$(ls "$QUEUE_DIR"/*.json 2>/dev/null | wc -l | tr -d ' ')
  legacy_depth=0
  [ -f "$QUEUE" ] && legacy_depth=$(wc -l < "$QUEUE" | tr -d ' ')
  [ -f "$QUEUE.migrating" ] && legacy_depth=$(( legacy_depth + $(wc -l < "$QUEUE.migrating" | tr -d ' ') ))
  queue_depth=$(( spool_depth + legacy_depth ))
  local last_push="never"
  [ -f "$LAST_PUSH_FILE" ] && last_push=$(cat "$LAST_PUSH_FILE" 2>/dev/null || echo never)
  local mode
  mode=$("$CONFIG_BIN" get artifacts_sync_mode 2>/dev/null || echo off)
  # Removals, reported whether or not publishing is on: how many tracked
  # files are gone from disk (null when that cannot be read), and how many of
  # those a sync holds for review.
  local removal_fields
  removal_fields=$(removals_scan 2>/dev/null \
    | python3 -c "$STATUS_FIELDS_PY" "$HELD_FILE" "$(removals_setting)" 2>/dev/null) || removal_fields=""
  printf '{"queue_depth":%s,"last_push":"%s","mode":"%s"%s}\n' "$queue_depth" "$last_push" "$mode" "${removal_fields:+,$removal_fields}"
}

IFS= read -r -d '' LIST_REMOVALS_PY <<'PYEOF' || true
import json, os, sys
held_path, spool_dir, setting = sys.argv[1:4]
try:
    scan = json.load(sys.stdin)
except ValueError:
    scan = {}
if not isinstance(scan, dict) or not scan.get("ok"):
    error = scan.get("error") if isinstance(scan, dict) else None
    print(f"cannot list removals ({error or 'git failed'}); nothing listed", file=sys.stderr)
    sys.exit(1)
try:
    with open(held_path) as f:
        held = json.load(f).get("held", {})
except (OSError, ValueError, AttributeError):
    held = {}
if not isinstance(held, dict):
    held = {}
queued = set()
try:
    names = os.listdir(spool_dir)
except OSError:
    names = []
for name in names:
    if name.endswith(".json"):
        try:
            with open(os.path.join(spool_dir, name)) as f:
                rec = json.loads(f.readline())
            if isinstance(rec, dict) and isinstance(rec.get("file"), str):
                queued.add(rec["file"])
        except (OSError, ValueError):
            pass
if scan.get("mode") == "off":
    print("artifacts sync is off (artifacts_sync_mode=off): nothing is listed or published")
    sys.exit(0)
pending = scan.get("pending") or []
if not pending:
    print("no removals pending")
    sys.exit(0)
print(f"{len(pending)} tracked file(s) gone from disk (artifacts_sync_removals={setting}):")
for p in pending:
    if p in held and p in queued:
        state = "held: " + str(held[p])
    elif setting != "on":
        state = "not published (artifacts_sync_removals=off)"
    elif p in queued:
        state = "queued"
    else:
        state = "queued at the next --discover-new"
    print(f"  {p}  [{state}]")
print("publish: gstack-brain-sync --publish-removals --yes [<path>...]")
PYEOF

subcmd_list_removals() {
  if [ ! -d "$GSTACK_HOME/.git" ]; then
    echo "artifacts sync is not initialized (no $GSTACK_HOME/.git)"
    exit 0
  fi
  removals_scan | python3 -c "$LIST_REMOVALS_PY" "$HELD_FILE" "$QUEUE_DIR" "$(removals_setting)"
}

IFS= read -r -d '' PUBLISH_SELECT_PY <<'PYEOF' || true
import json, sys
want_path, list_path = sys.argv[1:3]
try:
    scan = json.load(sys.stdin)
except ValueError:
    scan = {}
if not isinstance(scan, dict) or not scan.get("ok"):
    error = scan.get("error") if isinstance(scan, dict) else None
    print(f"cannot list removals ({error or 'git failed'}); nothing published", file=sys.stderr)
    sys.exit(1)
if scan.get("busy"):
    print("a merge or rebase is in progress in the artifacts repo; finish it first", file=sys.stderr)
    sys.exit(1)
pending = scan.get("pending") or []
with open(want_path) as f:
    want = list(dict.fromkeys(l.rstrip("\r\n") for l in f if l.strip()))
pending_set = set(pending)
unknown = [w for w in want if w not in pending_set]
if unknown:
    print("not a pending removal: " + ", ".join(unknown), file=sys.stderr)
    sys.exit(2)
chosen = want or pending
if not chosen:
    print("no removals pending")
    sys.exit(3)
with open(list_path, "w") as f:
    f.write("".join(p + "\n" for p in chosen))
print(f"{len(chosen)} removal(s):")
for p in chosen:
    print("  " + p)
PYEOF

# After a publish commit: drop the queue records and held entries of the
# paths it removed.
IFS= read -r -d '' PUBLISH_DONE_PY <<'PYEOF' || true
import json, os, sys
spool_dir, held_path, list_path = sys.argv[1:4]
with open(list_path) as f:
    done = {l.rstrip("\r\n") for l in f if l.strip()}
try:
    names = os.listdir(spool_dir)
except OSError:
    names = []
for name in names:
    full = os.path.join(spool_dir, name)
    if not name.endswith(".json"):
        continue
    try:
        with open(full) as f:
            rec = json.loads(f.readline())
        if isinstance(rec, dict) and rec.get("file") in done:
            os.unlink(full)
    except (OSError, ValueError):
        pass
try:
    with open(held_path) as f:
        held = json.load(f).get("held", {})
except (OSError, ValueError, AttributeError):
    held = None
if isinstance(held, dict):
    left = {k: v for k, v in held.items() if k not in done}
    if left:
        with open(held_path, "w") as f:
            json.dump({"held": left}, f, indent=1, sort_keys=True)
    else:
        os.unlink(held_path)
PYEOF

# Publish removals now, bypassing the valves: an explicit, reviewed action.
# Without --yes it only lists what it would remove.
subcmd_publish_removals() {
  local yes=0 want list rc lock_dir="${LOCK_FILE}.d" staged=0
  want=$(mktemp /tmp/brain-sync-want.XXXXXX) || exit 1
  list=$(mktemp /tmp/brain-sync-publish.XXXXXX) || { rm -f "$want"; exit 1; }
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      --) shift; while [ $# -gt 0 ]; do printf '%s\n' "$1" >> "$want"; shift; done; break ;;
      -*) echo "Unknown option: $1" >&2; rm -f "$want" "$list"; exit 2 ;;
      *) printf '%s\n' "$1" >> "$want" ;;
    esac
    shift
  done
  if ! sync_active; then
    echo "artifacts sync is off or not initialized; nothing to publish" >&2
    rm -f "$want" "$list"
    exit 1
  fi
  if ! take_run_lock; then
    echo "another gstack-brain-sync run holds $lock_dir; try again" >&2
    rm -f "$want" "$list"
    exit 1
  fi
  # As in --once: INT and TERM end the run, and a run stopped between staging
  # and committing unstages what it staged.
  trap 'trap "" INT TERM; [ "$staged" = 1 ] && abandon_staging "$list"; rm -f "$want" "$list" 2>/dev/null; rm -rf "$lock_dir" 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  removals_scan | python3 -c "$PUBLISH_SELECT_PY" "$want" "$list"
  rc=$?
  [ "$rc" -eq 3 ] && exit 0
  [ "$rc" -ne 0 ] && exit "$rc"
  if [ "$yes" -ne 1 ]; then
    echo "dry run: re-run with --yes to publish these removals"
    exit 0
  fi
  if ! git -C "$GSTACK_HOME" diff --cached --quiet 2>/dev/null; then
    echo "the artifacts repo has staged changes; commit or unstage them first" >&2
    exit 1
  fi
  local host receipt_id n ts why push_err push_rc=0 mrc=0 how=""
  host=$(remote_host)
  n=$(grep -c . "$list" || true)
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # Egress receipt before anything is committed, as --once does (C7): a
  # refusal exits here with nothing staged, committed or dequeued.
  # Its id gets the push's outcome below ($want is spent: it takes stderr).
  if ! receipt_id=$(GSTACK_HOME="$GSTACK_HOME" "$SCRIPT_DIR/gstack-egress-receipt" write \
      --sink brain-sync --host "$host" --class curated-memory-git-push \
      --no-payload --consent "artifacts_sync_mode!=off" 2>"$want") || [ -z "$receipt_id" ]; then
    write_status "push_failed" "EGRESS_RECEIPT_FAILED: receipt not writable; removals not published"
    _gstack_egress_refusal "brain-sync publish-removals" "$(head -c 300 "$want" 2>/dev/null)"
    exit 1
  fi
  # Stage them in the index as well, so it agrees with the commit below; a
  # file that came back is staged as a change and stops everything.
  # update-index takes literal paths, and one process for any number.
  staged=1
  tr -d '\r' < "$list" | tr '\n' '\0' | git -C "$GSTACK_HOME" update-index --remove -z --stdin >/dev/null 2>&1 || true
  if ! removals_staged_exactly "$list" strict; then
    unstage_listed "$list"
    staged=0
    echo "the staged removals do not match the list; nothing published" >&2
    exit 1
  fi
  if ! why=$(commit_removals "$list" "sync: remove $n file(s) | $ts"); then
    unstage_listed "$list"
    staged=0
    echo "commit failed (${why:-no message}); nothing published" >&2
    exit 1
  fi
  staged=0
  # Committed: their queue records and held entries are done.
  python3 -c "$PUBLISH_DONE_PY" "$QUEUE_DIR" "$HELD_FILE" "$list" 2>/dev/null || true
  push_err=$(GIT_TERMINAL_PROMPT=0 git -C "$GSTACK_HOME" push origin HEAD 2>&1 >/dev/null) || push_rc=$?
  GSTACK_HOME="$GSTACK_HOME" "$SCRIPT_DIR/gstack-egress-receipt" outcome "$receipt_id" "exit:$push_rc" >/dev/null 2>&1 || true
  if [ "$push_rc" -ne 0 ]; then
    merge_and_retry_push "$host" || mrc=$?
    [ "$MERGE_MOVED" = 1 ] && how=" after merging the remote's changes"
  fi
  if [ "$mrc" -eq 0 ]; then
    rm -f "$DIVERGED_FILE"
    # Only this run's removals count: the merge may also settle older ones.
    local back="" came
    came=$(printf '%s\n' "$MERGE_KEPT_LIST" | grep -Fxc -f "$list" || true)
    case "$came" in ''|0) ;; *) back="; $came of them came back, edited on another machine" ;; esac
    date -u +%Y-%m-%dT%H:%M:%SZ > "$LAST_PUSH_FILE"
    write_status "ok" "published $n removal(s)$how$back"
    echo "published $n removal(s)$how$back"
    exit 0
  fi
  if [ "$mrc" -eq 2 ]; then
    write_status "push_failed" "committed $n removal(s) locally; diverged from the remote ($MERGE_REASON); merge aborted. $(resolve_hint)"
    echo "committed $n removal(s); diverged from the remote ($MERGE_REASON); merge aborted. $(resolve_hint)" >&2
    exit 1
  fi
  write_status "push_failed" "committed $n removal(s) locally; push failed ($(push_reason "$push_err")); a later sync retries it"
  echo "committed $n removal(s); push failed ($(push_reason "$push_err")); a later gstack-brain-sync --once retries it" >&2
  # Exit here, never return: the EXIT trap names this function's locals.
  exit 1
}

subcmd_skip_file() {
  local path="${1:-}"
  if [ -z "$path" ]; then
    echo "Usage: gstack-brain-sync --skip-file <path>" >&2
    exit 1
  fi
  mkdir -p "$GSTACK_HOME"
  # Avoid duplicate entries.
  if [ -f "$SKIP_FILE" ] && grep -Fxq "$path" "$SKIP_FILE"; then
    echo "already in skip list: $path"
    exit 0
  fi
  echo "$path" >> "$SKIP_FILE"
  echo "added to skip list: $path"
  echo "(future writers will not enqueue this path; existing queue entries ignored on next --once)"
}

subcmd_drop_queue() {
  local force="${1:-}"
  if [ "$force" != "--yes" ]; then
    echo "Refusing: --drop-queue discards pending syncs. Pass --yes to confirm." >&2
    exit 1
  fi
  # Remove spool record files, then truncate any legacy queue remnant —
  # including a crash-leftover .migrating file, whose records would otherwise
  # resurrect on the next drain via migrate_legacy_queue after the user
  # explicitly discarded the queue.
  local n=0 f
  for f in "$QUEUE_DIR"/*.json; do
    [ -e "$f" ] || continue
    rm -f "$f" 2>/dev/null && n=$(( n + 1 ))
  done
  if [ -f "$QUEUE" ]; then
    local legacy_n
    legacy_n=$(wc -l < "$QUEUE" | tr -d ' ')
    n=$(( n + legacy_n ))
    : > "$QUEUE"
  fi
  if [ -f "$QUEUE.migrating" ]; then
    local mig_n
    mig_n=$(wc -l < "$QUEUE.migrating" | tr -d ' ')
    n=$(( n + mig_n ))
    rm -f "$QUEUE.migrating" 2>/dev/null || true
  fi
  # Held removals are queued records: none are held any more.
  rm -f "$HELD_FILE"
  if [ "$n" -eq 0 ]; then
    echo "queue already empty"
    exit 0
  fi
  echo "dropped $n queue entries"
}

IFS= read -r -d '' ENQUEUE_REMOVALS_PY <<'PYEOF' || true
import json, os, sys, time
from datetime import datetime, timezone
# Removals are level-triggered, not edge-triggered: every run makes sure each
# pending removal has one queued record, so a record lost to --drop-queue or a
# failed drain comes back, and a held one is never duplicated. Its cursor
# entry goes, so a file that returns is picked up again as a change.
spool_dir, cursor_path = sys.argv[1:3]
try:
    scan = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
pending = (scan.get("pending") or []) if isinstance(scan, dict) and scan.get("ok") else []
if not pending:
    sys.exit(0)
queued = set()
try:
    names = os.listdir(spool_dir)
except OSError:
    names = []
for name in names:
    if not name.endswith(".json"):
        continue
    try:
        with open(os.path.join(spool_dir, name)) as f:
            rec = json.loads(f.readline())
        if isinstance(rec, dict) and isinstance(rec.get("file"), str):
            queued.add(rec["file"])
    except (OSError, ValueError):
        pass
ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
try:
    os.makedirs(spool_dir, exist_ok=True)
    for i, rel in enumerate(p for p in pending if p not in queued):
        # Same record shape and tmp + os.replace write as the walk above.
        rec = json.dumps({"file": rel, "ts": ts}, separators=(",", ":"))
        tmp = os.path.join(spool_dir, f".tmp-{os.getpid()}-r{i}")
        with open(tmp, "w") as f:
            f.write(rec + "\n")
        os.replace(tmp, os.path.join(spool_dir, f"{int(time.time())}-{os.getpid()}-r{i}.json"))
        queued.add(rel)
except OSError:
    pass
try:
    with open(cursor_path) as f:
        cursor = json.load(f)
except (OSError, ValueError):
    cursor = None
if isinstance(cursor, dict) and any(p in cursor and p in queued for p in pending):
    for p in pending:
        if p in queued:
            cursor.pop(p, None)
    try:
        with open(cursor_path, "w") as f:
            json.dump(cursor, f)
    except OSError:
        pass
PYEOF

subcmd_discover_new() {
  if ! sync_active; then
    exit 0
  fi
  # Walk allowlist globs; enqueue any file where mtime+size differs from cursor.
  python3 - "$GSTACK_HOME" "$ALLOWLIST" "$DISCOVER_CURSOR" <<'PYEOF' 2>/dev/null || true
import sys, os, json, fnmatch, time
from datetime import datetime, timezone

gstack_home, allowlist_path, cursor_path = sys.argv[1:4]
spool_dir = os.path.join(gstack_home, ".brain-queue.d")
skip_path = os.path.join(gstack_home, ".brain-skip.txt")

def load_lines(path):
    try:
        with open(path) as f:
            return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    except FileNotFoundError:
        return []

def load_cursor(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}

def save_cursor(path, data):
    try:
        with open(path, "w") as f:
            json.dump(data, f)
    except OSError:
        pass

allowlist = load_lines(allowlist_path)
# Normalize skip entries to the same POSIX form as `rel` below, so a
# backslash entry in .brain-skip.txt still matches a normalized path on Windows.
skip = {s.replace(os.sep, "/") for s in load_lines(skip_path)}
cursor = load_cursor(cursor_path)
new_cursor = dict(cursor)
to_enqueue = []

# Walk all files under gstack_home, match against allowlist.
for root, dirs, files in os.walk(gstack_home):
    # Skip .git and .brain-* state files.
    if ".git" in root.split(os.sep):
        continue
    for name in files:
        full = os.path.join(root, name)
        # Repo paths are POSIX-relative. os.path.relpath yields backslash
        # separators on Windows, which never match the forward-slash allowlist
        # globs (e.g. "projects/*/learnings.jsonl"), so discovery silently
        # enqueued nothing under projects/ on Windows. Normalize to "/".
        rel = os.path.relpath(full, gstack_home).replace(os.sep, "/")
        if rel.startswith(".brain-"):
            continue
        if not any(fnmatch.fnmatchcase(rel, pat) for pat in allowlist):
            continue
        if rel in skip:
            continue
        try:
            st = os.stat(full)
            key = f"{int(st.st_mtime)}:{st.st_size}"
        except OSError:
            continue
        if cursor.get(rel) != key:
            to_enqueue.append((rel, key))

# Write spool records directly. The previous implementation shelled out to
# gstack-brain-enqueue once per file, but Windows Python cannot exec a
# bash-shebang script (the spawn fails with a fork error), so discovery
# enqueued nothing on Windows even after the path-match fix above.
# Writing the record here is platform-agnostic; the drain step
# (compute_paths_to_stage) still re-applies the skip-list + privacy filters.
if to_enqueue:
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    written = []
    try:
        # One spool FILE per record (tmp write + atomic os.replace), matching
        # gstack-brain-enqueue's maildir contract: writers and the drain never
        # share an inode, so a parallel writer or drain can't race this.
        # Compact separators match the shim's JSON shape.
        os.makedirs(spool_dir, exist_ok=True)
        for i, (rel, key) in enumerate(to_enqueue):
            rec = json.dumps({"file": rel, "ts": ts}, separators=(",", ":"))
            tmp = os.path.join(spool_dir, f".tmp-{os.getpid()}-d{i}")
            with open(tmp, "w") as f:
                f.write(rec + "\n")
            os.replace(tmp, os.path.join(spool_dir, f"{int(time.time())}-{os.getpid()}-d{i}.json"))
            written.append((rel, key))
    except OSError:
        # Spool write failed (disk full, AV file lock). Leave the cursor
        # unadvanced for unwritten records so they are retried on the next
        # discover instead of being silently recorded as synced (which loses
        # the change until the file next changes).
        pass
    # Advance the cursor only for records actually written.
    for rel, key in written:
        new_cursor[rel] = key

save_cursor(cursor_path, new_cursor)
PYEOF
  # With artifacts_sync_removals on, also queue the pending removals.
  if [ "$(removals_setting)" = "on" ]; then
    removals_scan 2>/dev/null \
      | python3 -c "$ENQUEUE_REMOVALS_PY" "$QUEUE_DIR" "$DISCOVER_CURSOR" 2>/dev/null || true
  fi
}

# -------- dispatch --------
case "${1:-}" in
  --once|"") subcmd_once ;;
  --status) subcmd_status ;;
  --skip-file) shift; subcmd_skip_file "${1:-}" ;;
  --drop-queue) shift; subcmd_drop_queue "${1:-}" ;;
  --discover-new) subcmd_discover_new ;;
  --list-removals) subcmd_list_removals ;;
  --publish-removals) shift; subcmd_publish_removals "$@" ;;
  --help|-h)
    sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Unknown subcommand: $1" >&2
    echo "Run: gstack-brain-sync --help" >&2
    exit 1
    ;;
esac
