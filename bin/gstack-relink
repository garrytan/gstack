#!/usr/bin/env bash
# gstack-relink — re-create skill symlinks based on skill_prefix config
#
# Usage:
#   gstack-relink
#
# Env overrides (for testing):
#   GSTACK_STATE_DIR   — override ~/.gstack state directory
#   GSTACK_INSTALL_DIR — override gstack install directory
#   GSTACK_SKILLS_DIR  — override target skills directory
set -euo pipefail

IS_WINDOWS=0
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) IS_WINDOWS=1 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GSTACK_CONFIG="${SCRIPT_DIR}/gstack-config"
source "${SCRIPT_DIR}/gstack-registration-lock"

# Detect install dir
INSTALL_DIR="${GSTACK_INSTALL_DIR:-}"
if [ -z "$INSTALL_DIR" ]; then
  if [ -d "${SCRIPT_DIR}/.." ] && [ -f "${SCRIPT_DIR}/../setup" ]; then
    INSTALL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
  elif [ -f "$HOME/.claude/skills/.gstack-root" ]; then
    _MARKED_INSTALL="$(head -n 1 "$HOME/.claude/skills/.gstack-root" 2>/dev/null || true)"
    [ -d "$_MARKED_INSTALL" ] && INSTALL_DIR="$(cd "$_MARKED_INSTALL" && pwd -P)"
  elif [ -d "$HOME/.claude/skills/gstack" ]; then
    INSTALL_DIR="$HOME/.claude/skills/gstack"
  fi
fi

if [ -z "$INSTALL_DIR" ] || [ ! -d "$INSTALL_DIR" ]; then
  echo "Error: gstack install directory not found." >&2
  echo "Run: cd ~/.claude/skills/gstack && ./setup" >&2
  exit 1
fi

# Detect target skills dir
SKILLS_DIR="${GSTACK_SKILLS_DIR:-$(dirname "$INSTALL_DIR")}"
[ -d "$SKILLS_DIR" ] || mkdir -p "$SKILLS_DIR"

if [ "${GSTACK_SETUP_RUNNING:-0}" != "1" ]; then
  if ! gstack_registration_lock_acquire "$SKILLS_DIR/.gstack-registration.lock"; then
    echo "Error: registration aborted." >&2
    exit 1
  fi
  trap gstack_registration_lock_release EXIT
fi

# Read prefix setting
PREFIX=$("$GSTACK_CONFIG" get skill_prefix 2>/dev/null || echo "false")

# Ownership checks deliberately require an exact install root or exact legacy
# symlink target. Names containing "gstack" are not proof of ownership.
INSTALL_REAL="$(cd "$INSTALL_DIR" && pwd -P)"

_expected_real() {
  local expected="$1"
  printf '%s/%s\n' "$(cd "$(dirname "$expected")" && pwd -P)" "$(basename "$expected")"
}

_target_owned() {
  local expected="$1"
  local target="$2"
  local expected_real target_real owner owner_real linked linked_real
  expected_real="$(_expected_real "$expected")"
  if [ -L "$target" ]; then
    target_real=$(cd "$target" 2>/dev/null && pwd -P || true)
    [ -n "$target_real" ] && [ "$target_real" = "$(dirname "$expected_real")" ]
    return
  fi
  [ -d "$target" ] || return 1
  if [ -f "$target/.gstack-managed-root" ]; then
    owner=$(head -n 1 "$target/.gstack-managed-root" 2>/dev/null || true)
    owner_real=$(cd "$owner" 2>/dev/null && pwd -P || true)
    [ -n "$owner_real" ] && [ "$owner_real" = "$INSTALL_REAL" ] && return 0
  fi
  if [ -L "$target/SKILL.md" ]; then
    linked=$(readlink "$target/SKILL.md" 2>/dev/null || true)
    linked_real=$(cd "$(dirname "$linked")" 2>/dev/null && pwd -P || true)
    [ -n "$linked_real" ] && [ "$linked_real/$(basename "$linked")" = "$expected_real" ] && return 0
  elif [ "$IS_WINDOWS" -eq 1 ] && [ -f "$target/SKILL.md" ] && cmp -s "$target/SKILL.md" "$expected"; then
    return 0
  fi
  return 1
}

_validate_desired_target() {
  local expected="$1"
  local target="$2"
  [ ! -e "$target" ] && [ ! -L "$target" ] && return 0
  _target_owned "$expected" "$target" && return 0
  if [ -d "$target" ] && [ -z "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    return 0
  fi
  echo "Error: refusing to overwrite foreign skill target $target" >&2
  return 1
}

_validate_cleanup_target() {
  local expected="$1"
  local target="$2"
  [ ! -e "$target" ] && [ ! -L "$target" ] && return 0
  _target_owned "$expected" "$target" && return 0
  echo "Error: refusing to remove foreign skill target $target" >&2
  return 1
}

_cleanup_skill_entry() {
  local expected="$1"
  local entry="$2"
  [ ! -e "$entry" ] && [ ! -L "$entry" ] && return 0
  _target_owned "$expected" "$entry" || return 1
  if [ -L "$entry" ]; then
    rm -f "$entry"
  else
    rm -f "$entry/SKILL.md" "$entry/.gstack-managed-root"
    rm -rf "$entry/sections"
    rmdir "$entry" 2>/dev/null || true
  fi
}

_link_skill_alias() {
  local expected="$1"
  local target="$2"
  _validate_desired_target "$expected" "$target"
  if [ -L "$target" ]; then
    rm -f "$target"
  elif [ -d "$target" ]; then
    rm -f "$target/SKILL.md" "$target/.gstack-managed-root"
    rm -rf "$target/sections"
  fi
  mkdir -p "$target"
  ln -snf "$expected" "$target/SKILL.md"
  if [ -d "$(dirname "$expected")/sections" ]; then
    ln -snf "$(dirname "$expected")/sections" "$target/sections"
  fi
  printf '%s\n' "$INSTALL_REAL" > "$target/.gstack-managed-root"
}

# Discover and validate the complete mutation set first.
SKILLS=()
LINK_NAMES=()
OLD_TARGETS=()
for skill_dir in "$INSTALL_DIR"/*/; do
  [ -d "$skill_dir" ] || continue
  skill=$(basename "$skill_dir")
  # Skip non-skill directories
  case "$skill" in bin|browse|design|docs|extension|lib|node_modules|scripts|test|.git|.github) continue ;; esac
  [ -f "$skill_dir/SKILL.md" ] || continue
  old_target=""

  if [ "$PREFIX" = "true" ]; then
    # Don't double-prefix directories already named gstack-*
    case "$skill" in
      gstack-*) link_name="$skill" ;;
      *)        link_name="gstack-$skill" ;;
    esac
    old_target="$SKILLS_DIR/$skill"
  else
    link_name="$skill"
    case "$skill" in
      gstack-*) old_target="" ;;
      *)        old_target="$SKILLS_DIR/gstack-$skill" ;;
    esac
  fi
  expected="$INSTALL_DIR/$skill/SKILL.md"
  target="$SKILLS_DIR/$link_name"
  _validate_desired_target "$expected" "$target"
  if [ -n "$old_target" ] && [ "$old_target" != "$target" ]; then
    _validate_cleanup_target "$expected" "$old_target"
  fi
  SKILLS+=("$skill")
  LINK_NAMES+=("$link_name")
  OLD_TARGETS+=("$old_target")
done

if [ -f "$INSTALL_DIR/SKILL.md" ]; then
  _validate_desired_target "$INSTALL_DIR/SKILL.md" "$SKILLS_DIR/_gstack-command"
fi

if [ -f "$INSTALL_DIR/SKILL.md" ]; then
  _link_skill_alias "$INSTALL_DIR/SKILL.md" "$SKILLS_DIR/_gstack-command"
fi

SKILL_COUNT=0
for i in "${!SKILLS[@]}"; do
  skill="${SKILLS[$i]}"
  expected="$INSTALL_DIR/$skill/SKILL.md"
  old_target="${OLD_TARGETS[$i]}"
  target="$SKILLS_DIR/${LINK_NAMES[$i]}"
  if [ -n "$old_target" ] && [ "$old_target" != "$target" ]; then
    _cleanup_skill_entry "$expected" "$old_target"
  fi
  _link_skill_alias "$expected" "$target"
  SKILL_COUNT=$((SKILL_COUNT + 1))
done

# Patch SKILL.md name: fields to match prefix setting
"$INSTALL_DIR/bin/gstack-patch-names" "$INSTALL_DIR" "$PREFIX"

if [ "$PREFIX" = "true" ]; then
  echo "Relinked $SKILL_COUNT skills as gstack-*"
else
  echo "Relinked $SKILL_COUNT skills as flat names"
fi
