#!/usr/bin/env bash
# gstack-relink — re-create skill symlinks based on skill_prefix config
#
# Usage:
#   gstack-relink
#
# Env overrides (for testing):
#   GSTACK_STATE_DIR   — override ~/.gstack state directory
#   GSTACK_INSTALL_DIR — override gstack install directory
#   GSTACK_SKILLS_DIR  — override target skills directory
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GSTACK_CONFIG="${SCRIPT_DIR}/gstack-config"

# Detect install dir
INSTALL_DIR="${GSTACK_INSTALL_DIR:-}"
if [ -z "$INSTALL_DIR" ]; then
  if [ -d "$HOME/.claude/skills/gstack" ]; then
    INSTALL_DIR="$HOME/.claude/skills/gstack"
  elif [ -d "${SCRIPT_DIR}/.." ] && [ -f "${SCRIPT_DIR}/../setup" ]; then
    INSTALL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
  fi
fi

if [ -z "$INSTALL_DIR" ] || [ ! -d "$INSTALL_DIR" ]; then
  echo "Error: gstack install directory not found." >&2
  echo "Run: cd ~/.claude/skills/gstack && ./setup" >&2
  exit 1
fi

# Detect target skills dir
SKILLS_DIR="${GSTACK_SKILLS_DIR:-$(dirname "$INSTALL_DIR")}"
[ -d "$SKILLS_DIR" ] || mkdir -p "$SKILLS_DIR"

# Read prefix setting
PREFIX=$("$GSTACK_CONFIG" get skill_prefix 2>/dev/null || echo "false")

# Return success only for a wrapper this install can prove it owns. A directory
# name is not proof: users may have their own same-name skill.
_managed_skill_entry() {
  local entry="$1" source_dir="$2" canonical_name="$3" prefix="$4"
  [ ! -e "$entry" ] && [ ! -L "$entry" ] && return 0

  if [ -d "$entry" ] && [ "$(cat "$entry/.gstack-skill-projection" 2>/dev/null || true)" = "gstack-skill-projection-v1" ]; then
    return 0
  fi

  # Legacy gstack wrappers were directory symlinks or a copied projected
  # SKILL.md. Adopt only when the link resolves to this exact install or the
  # copied file is byte-identical to the projection this install would make.
  if [ -L "$entry" ] && [ "$(readlink -f "$entry" 2>/dev/null || true)" = "$(readlink -f "$source_dir" 2>/dev/null || true)" ]; then
    return 0
  fi
  if [ -d "$entry" ] && [ -L "$entry/SKILL.md" ] && \
     [ "$(readlink -f "$entry/SKILL.md" 2>/dev/null || true)" = "$(readlink -f "$source_dir/SKILL.md" 2>/dev/null || true)" ]; then
    return 0
  fi
  if [ -d "$entry" ] && [ -f "$entry/SKILL.md" ] && \
     "$INSTALL_DIR/bin/gstack-patch-names" --matches-projection "$source_dir/SKILL.md" "$entry/SKILL.md" "$canonical_name" "$prefix"; then
    return 0
  fi
  return 1
}

_refuse_unowned_skill_entry() {
  local entry="$1"
  echo "gstack-relink: refusing to replace unowned skill wrapper: $entry" >&2
  echo "Move or remove it manually, then run gstack-relink again." >&2
  return 1
}

_cleanup_skill_entry() {
  local entry="$1" source_dir="$2" canonical_name="$3" prefix="$4"
  [ ! -e "$entry" ] && [ ! -L "$entry" ] && return 0
  _managed_skill_entry "$entry" "$source_dir" "$canonical_name" "$prefix" || _refuse_unowned_skill_entry "$entry"
  rm -rf "$entry"
}

_prepare_skill_entry() {
  local entry="$1" source_dir="$2" canonical_name="$3" prefix="$4"
  [ ! -e "$entry" ] && [ ! -L "$entry" ] || {
    _managed_skill_entry "$entry" "$source_dir" "$canonical_name" "$prefix" || _refuse_unowned_skill_entry "$entry"
    rm -rf "$entry"
  }
  mkdir -p "$entry"
}

_link_root_skill_alias() {
  local target="$SKILLS_DIR/_gstack-command"

  [ -f "$INSTALL_DIR/SKILL.md" ] || return 0
  [ -L "$target" ] && rm -f "$target"
  mkdir -p "$target"
  ln -snf "$INSTALL_DIR/SKILL.md" "$target/SKILL.md"
}

_link_root_skill_alias

# Discover skills (directories with SKILL.md, excluding meta dirs)
SKILL_COUNT=0
for skill_dir in "$INSTALL_DIR"/*/; do
  [ -d "$skill_dir" ] || continue
  skill=$(basename "$skill_dir")
  # Skip non-skill directories
  case "$skill" in bin|browse|design|docs|extension|lib|node_modules|scripts|test|.git|.github) continue ;; esac
  [ -f "$skill_dir/SKILL.md" ] || continue

  canonical_name=$(grep -m1 '^name:' "$skill_dir/SKILL.md" 2>/dev/null | sed 's/^name:[[:space:]]*//' | tr -d '[:space:]' || true)
  [ -n "$canonical_name" ] || canonical_name="$skill"

  if [ "$PREFIX" = "true" ]; then
    case "$canonical_name" in
      gstack-*) link_name="$canonical_name" ;;
      *)        link_name="gstack-$canonical_name" ;;
    esac
    # Remove old flat entry if it exists (and isn't the same as the new link)
    [ "$link_name" != "$canonical_name" ] && _cleanup_skill_entry "$SKILLS_DIR/$canonical_name" "$skill_dir" "$canonical_name" false
  else
    link_name="$canonical_name"
    # Don't remove gstack-* dirs that are their real name (e.g., gstack-upgrade)
    case "$canonical_name" in
      gstack-*) ;; # Already the real name, no old prefixed link to clean
      *)        _cleanup_skill_entry "$SKILLS_DIR/gstack-$canonical_name" "$skill_dir" "$canonical_name" true ;;
    esac
  fi
  target="$SKILLS_DIR/$link_name"
  # Create a real wrapper. Prefix metadata belongs to this wrapper, not the
  # canonical install source, so it must be a copied file rather than a symlink.
  _prepare_skill_entry "$target" "$skill_dir" "$canonical_name" "$PREFIX"
  "$INSTALL_DIR/bin/gstack-patch-names" "$skill_dir/SKILL.md" "$target/SKILL.md" "$canonical_name" "$PREFIX"
  SKILL_COUNT=$((SKILL_COUNT + 1))
done

if [ "$PREFIX" = "true" ]; then
  echo "Relinked $SKILL_COUNT skills as gstack-*"
else
  echo "Relinked $SKILL_COUNT skills as flat names"
fi
