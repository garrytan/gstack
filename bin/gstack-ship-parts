#!/usr/bin/env -S bun --no-env-file --config=/dev/null
/**
 * gstack-ship-parts — the section text /ship's next phase uses, verbatim, split at headings and
 * returned once per run inside the phase program before it (GSTA-167 C5). Logic: lib/ship-parts.ts.
 */
import { shipParts } from '../lib/ship-parts';

const out = shipParts(process.argv.slice(2));
(out.exit === 2 ? process.stderr : process.stdout).write(out.text);
process.exit(out.exit);
