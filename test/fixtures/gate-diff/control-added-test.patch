+import { test, expect } from 'bun:test';
+import { add } from '../src/add';
+
+test('adds two numbers', () => {
+  expect(add(1, 2)).toBe(3);
+});
+
+test('adds negatives', () => {
+  expect(add(-1, -2)).toBe(-3);
+});
+
+test('is commutative', () => {
+  expect(add(2, 3)).toBe(add(3, 2));
+});
