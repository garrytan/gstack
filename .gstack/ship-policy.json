{
  "$schema": "https://github.com/garrytan/gstack/docs/ship-policy.md#schema-v1",
  "bump": "patch",
  "queue_mode": "stamp-at-merge",
  "release_tool": "bun scripts/gen-agents-digest.ts",
  "release_outputs": ["agents-digest/gstack-AGENTS.md"],
  "stamp_paths": ["lib/ship-policy.ts", "lib/ship-policy-keys.ts"],
  "stamp_patterns": ["_KEY_VERSION = '{version}'"],
  "changelog": "CHANGELOG.md",
  "mirror": null,
  "history": "squash-ok",
  "preregistration_shas": [],
  "stamp_sensitive_gates": ["tests"],
  "pr_count": { "default_pr_count": 1, "split_requires_owner": true },
  "maintainers": ["garrytan"],
  "train": { "gate_workflow": "evals.yml", "free_workflow": "free-tests.yml", "full_gate_check": "gstack/full-gate", "record_artifact": "gstack-train-record", "max_size": 5, "fill_hours": 1, "screen_selection": "gstack-paid", "trial_reservation_usd": 1.5 },
  "changelog_fragments": { "dir": "changelog.d", "required_checks": ["free-tests", "windows-smoke", "Check VERSION is not stale vs queue", "quality", "check-freshness", "actionlint"] },
  "merge": "direct",
  "land": {
    "merged_checks": [
      "bun run typecheck",
      "bun run gen:skill-docs --host all && git diff --exit-code",
      "bun test ./test/ship-driver.test.ts ./test/skill-md-size-guard.test.ts ./test/skill-size-budget.test.ts ./test/module-size-ratchet.test.ts ./test/context-budget-ratchet.test.ts ./test/catalog-budget.test.ts ./test/claude-md-size.test.ts ./test/parity-suite.test.ts ./test/gstack-ship-policy.test.ts",
      "bun test ./test/strict-output.test.ts ./test/gen-skill-docs.test.ts ./test/skill-check-driver.test.ts ./test/skill-ceo-section-ordering.test.ts ./test/qa-functional-observer.test.ts ./test/qa-checkpoint-evidence.test.ts ./test/test-free-shards-capture.test.ts --timeout=30000 --max-concurrency=1"
    ]
  },
  "min_gstack_version": "1.96.0.0"
}
