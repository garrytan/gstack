{
  "$schema": "https://github.com/garrytan/gstack/docs/ship-policy.md#schema-v1",
  "bump": "patch",
  "queue_mode": "stamp-at-merge",
  "release_tool": "bun scripts/gen-agents-digest.ts",
  "release_outputs": ["agents-digest/gstack-AGENTS.md"],
  "stamp_paths": ["lib/ship-policy.ts", "lib/ship-policy-keys.ts"],
  "stamp_patterns": ["_KEY_VERSION = '{version}'"],
  "changelog": "CHANGELOG.md",
  "mirror": null,
  "history": "squash-ok",
  "preregistration_shas": [],
  "stamp_sensitive_gates": ["tests"],
  "pr_count": { "default_pr_count": 1, "split_requires_owner": true },
  "maintainers": ["garrytan"],
  "train": { "gate_workflow": "evals.yml", "free_workflow": "free-tests.yml", "full_gate_check": "gstack/full-gate", "record_artifact": "gstack-train-record", "max_size": 5, "fill_hours": 1, "screen_selection": "gstack-paid", "trial_reservation_usd": 1.5 },
  "changelog_fragments": { "dir": "changelog.d", "required_checks": ["free-tests", "windows-smoke", "Check VERSION is not stale vs queue", "quality", "check-freshness", "actionlint", "Plain title"] },
  "merge": "direct",
  "land": {
    "merged_checks": [
      "bun run typecheck",
      "bun run gen:skill-docs --host all && test -z \"$(git status --porcelain -- . ':(exclude)node_modules')\"",
      "bun run scripts/test-free-shards.ts --files-from test/land-merged-checks.txt --wall-timeout 600"
    ]
  },
  "release_gate": { "cadence_hours": 8, "gate_workflow": "evals.yml", "branch": "main", "stable_ref": "stable", "check_name": "main-backstop", "on_red": "hold-release", "bisect_spend_cap_usd": 80 },
  "min_gstack_version": "1.96.0.0"
}
